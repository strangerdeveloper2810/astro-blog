---
import { Icon } from "astro-icon/components";
import "@styles/base.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CYBER_FOLIO // Nguyen Hai Trinh</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700;800&family=JetBrains+Mono:wght@300;400;500;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --color-bg-base: #04050e;
        --color-cyan: #00f0ff;
        --color-purple: #b55fe6;
        --color-glass: rgba(10, 11, 24, 0.7);
        --color-border: rgba(0, 240, 255, 0.15);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        background-color: var(--color-bg-base);
        color: #d1d5db;
        font-family: 'DM Sans', sans-serif;
        overflow-x: hidden;
        min-height: 100vh;
      }

      /* Vibrant background mesh gradient */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -2;
        background: 
          radial-gradient(ellipse 60% 40% at 85% 15%, rgba(181, 95, 230, 0.22) 0%, transparent 60%),
          radial-gradient(ellipse 50% 50% at 15% 85%, rgba(0, 240, 255, 0.18) 0%, transparent 60%),
          radial-gradient(circle at 50% 50%, rgba(4, 5, 12, 0.98) 0%, rgba(2, 3, 7, 1) 100%);
      }

      /* Fine dot grid overlay */
      .dot-grid {
        position: fixed;
        inset: 0;
        z-index: -1;
        background-image: radial-gradient(rgba(0, 240, 255, 0.05) 1px, transparent 1px);
        background-size: 20px 20px;
        pointer-events: none;
      }

      /* Scanning line overlay */
      .scanline {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 6px;
        background: linear-gradient(to bottom, rgba(0, 240, 255, 0) 0%, rgba(0, 240, 255, 0.12) 50%, rgba(0, 240, 255, 0) 100%);
        z-index: 50;
        pointer-events: none;
        animation: scanline-sweep 12s linear infinite;
        will-change: transform;
      }

      @keyframes scanline-sweep {
        0% { transform: translateY(-10vh); }
        100% { transform: translateY(110vh); }
      }

      /* Font rules */
      .font-kanit {
        font-family: 'Kanit', sans-serif !important;
      }
      .font-mono-tech {
        font-family: 'JetBrains Mono', monospace !important;
        font-weight: 400;
      }

      /* Title gradients */
      .cyan-purple-gradient {
        background: linear-gradient(90deg, #00f0ff 0%, #b55fe6 100%);
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
        background-clip: text !important;
        color: transparent !important;
        display: inline-block;
      }

      /* Giant Master Card (Left Column) */
      .master-hud-container {
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(9, 10, 22, 0.85);
        backdrop-filter: blur(20px);
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      }

      /* Interactive Glass Panels */
      .glass-panel {
        background: rgba(13, 14, 30, 0.65);
        border: 1px solid rgba(0, 240, 255, 0.15);
        border-radius: 12px;
        backdrop-filter: blur(12px);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        transform-style: preserve-3d;
        will-change: transform, box-shadow;
      }

      /* Tactical Corners pseudo-elements */
      .tactical-corners {
        position: relative;
      }
      .tactical-corners::before, .tactical-corners::after {
        content: '';
        position: absolute;
        width: 10px;
        height: 10px;
        border-color: var(--color-cyan);
        border-style: solid;
        pointer-events: none;
        opacity: 0.5;
        transition: all 0.3s ease;
      }
      .tactical-corners::before {
        top: -1px;
        left: -1px;
        border-width: 1.5px 0 0 1.5px;
        border-top-left-radius: 6px;
      }
      .tactical-corners::after {
        bottom: -1px;
        right: -1px;
        border-width: 0 1.5px 1.5px 0;
        border-bottom-right-radius: 6px;
      }

      .glass-panel:hover {
        border-color: rgba(0, 240, 255, 0.4);
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.15), inset 0 0 10px rgba(0, 240, 255, 0.04);
      }
      .glass-panel:hover .tactical-corners::before, .glass-panel:hover .tactical-corners::after {
        opacity: 1;
        width: 14px;
        height: 14px;
        filter: drop-shadow(0 0 3px var(--color-cyan));
      }

      /* Metre filling */
      .hud-meter-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--color-cyan) 0%, var(--color-purple) 100%);
        border-radius: 2px;
        box-shadow: 0 0 6px rgba(0, 240, 255, 0.4);
      }

      /* Custom animations */
      .glow-soft {
        text-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
      }

      /* Pulse Indicator */
      .status-pulse {
        position: relative;
        display: inline-flex;
        height: 8px;
        width: 8px;
      }
      .status-pulse::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 9999px;
        background-color: var(--color-cyan);
        animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
        opacity: 0.75;
      }
      .status-pulse::after {
        content: '';
        position: relative;
        border-radius: 9999px;
        height: 8px;
        width: 8px;
        background-color: var(--color-cyan);
      }
      @keyframes ping {
        75%, 100% {
          transform: scale(2.5);
          opacity: 0;
        }
      }
    </style>
  </head>
  <body class="min-h-screen relative p-4 md:p-8 flex items-center justify-center">
