---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";
import SocialLink from "../components/SocialLink.astro";
import Link from "../components/Link.astro";
---

<Layout seo={homePageContent.seo}>
  <!-- Floating particles background -->
  <div class="floating-particles">
    <div
      class="particle"
      style="top: 10%; left: 10%; width: 4px; height: 4px; animation-delay: 0s;"
    >
    </div>
    <div
      class="particle"
      style="top: 20%; right: 20%; width: 6px; height: 6px; animation-delay: 2s;"
    >
    </div>
    <div
      class="particle"
      style="top: 50%; left: 5%; width: 3px; height: 3px; animation-delay: 4s;"
    >
    </div>
    <div
      class="particle"
      style="bottom: 30%; right: 10%; width: 5px; height: 5px; animation-delay: 6s;"
    >
    </div>
    <div
      class="particle"
      style="bottom: 10%; left: 30%; width: 4px; height: 4px; animation-delay: 1s;"
    >
    </div>
  </div>

  <article class="mt-10 max-w-2xl mx-auto px-6">
    <header class="animate-fadeInDown">
      <h1 class="text-3xl mb-1">{identity.name}</h1>
      <p class="opacity-60 mb-10 subtitle">
        <span id="typing-text" class="typing-text"></span>
        <span
          class="lazy-badge inline-flex items-center bg-[#2a2a2a] text-[#ffe895] text-xs font-semibold ml-2 px-2.5 py-0.5 rounded-full border border-[#3a3a3a]"
        >
          <span
            class="inline-block w-2 h-2 rounded-full bg-[#00abda] mr-1.5 pulse-dot"
          ></span>
          Open for freelance/ Remote opportunities
        </span>
      </p>
    </header>

    <section
      class="flex flex-col md:flex-row gap-8 mb-12 animate-fadeInLeft delay-200"
    >
      <div class="flex-shrink-0">
        <div class="relative group">
          <Image
            src="/img/me_2.jpg"
            alt="Professional portrait of Nguyen Hai Trinh, Software Engineer specializing in React.js, Vue.js and Trading Platforms"
            width={150}
            height={150}
            loading="eager"
            decoding="async"
            quality={100}
            densities={[1.5, 2]}
            class="rounded-xl border-2 border-[#3a3a3a] border-opacity-80 profile-image hover-glow transition-all duration-300 filter hover:brightness-110"
          />
          <div
            class="absolute inset-0 rounded-xl bg-gradient-to-r from-blue-500/20 to-purple-500/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
          </div>
        </div>
        
        <nav
          class="mt-4 flex flex-row md:flex-col justify-center gap-2 w-fit social-bar"
          aria-label="Social media links"
        >
          {
            homePageContent.homeSocialLinks.map((link, index) => (
              <div class={`social-item delay-${(index + 1) * 100}`}>
                <SocialLink
                  title={link.title}
                  url={link.url}
                  icon={link.icon}
                  external={link.external}
                />
              </div>
            ))
          }
        </nav>
      </div>

      <div class="flex-grow space-y-6 animate-fadeInRight delay-400">
        <div
          class="holographic neon-glow p-6 rounded-xl transition-all duration-300 scroll-reveal"
        >
          <h2 class="text-xl font-bold mb-4 cyber-text">👋 Hey there!</h2>
          <p class="leading-relaxed">
            I'm a <strong>Software Engineer</strong> with 3+ years of experience
            building scalable web applications using modern technologies. I specialize
            in frontend development and am expanding into backend with <strong
              class="text-blue-400">React.js</strong
            >, <strong class="text-blue-400">Vue.js</strong>, <strong
              class="text-blue-400">TypeScript</strong
            >, <strong class="text-blue-400">Go</strong>, and <strong
              class="text-blue-400">Node.js</strong
            >.
          </p>
        </div>

        <div class="space-y-4 scroll-reveal">
          <h3 class="text-lg font-semibold cyber-text">
            🚀 Recent Achievements
          </h3>
          <ul class="space-y-2 list-none">
            <li class="flex items-start gap-2">
              <span class="text-blue-400">▹</span>
              Led frontend development for Trading Nano platform with real-time TradingView
              Advanced Charts integration
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400">▹</span>
              Built F1 Trading Ecosystem with Vue 3, TypeScript, and Spring Boot
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400">▹</span>
              Architected KOMO Booking & Admin platforms serving multiple salon chains
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400">▹</span>
              Developed IoT solutions for smart building management systems
            </li>
          </ul>
        </div>

        <div class="scroll-reveal space-y-6">
          <div>
            <h3 class="text-lg font-semibold mb-3 cyber-text">🛠️ Tech Stack</h3>
            <div class="space-y-4">
              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">
                  Frontend Development
                </h4>
                <div class="flex flex-wrap gap-2">
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >React.js</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Next.js</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Vue.js</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >TypeScript</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Redux Toolkit</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >GraphQL</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >TradingView Advanced Charts</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >WebSocket</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >TailwindCSS</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >MUI</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Ant Design</span
                  >
                </div>
              </div>

              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">
                  Mobile Development
                </h4>
                <div class="flex flex-wrap gap-2">
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Flutter</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >React Native</span
                  >
                </div>
              </div>

              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">
                  Backend & APIs
                </h4>
                <div class="flex flex-wrap gap-2">
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Go</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Node.js</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Java</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Spring Boot</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Express.js</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >GraphQL</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >REST APIs</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >MySQL</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >MongoDB</span
                  >
                </div>
              </div>

              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">
                  Development & Tools
                </h4>
                <div class="flex flex-wrap gap-2">
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Git</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Docker</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Vite</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Rsbuild</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Jenkins</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Bitbucket Pipelines</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >Jest</span
                  >
                  <span
                    class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all"
                    >ESLint</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-4 scroll-reveal">
          <p class="text-sm opacity-80">
            When I'm not coding, you'll find me debugging with ☕, exploring new
            tech 🧠, and staying active at the gym 💪
          </p>
        </div>
      </div>
    </section>

      <nav
        class="flex flex-wrap items-center gap-4 group w-fit mt-8 animate-fadeInUp delay-600"
        aria-label="Navigation links"
      >
        {
          homePageContent.links.map((link, index) => (
            <div class={`hover-lift delay-${(index + 1) * 100}`}>
              <Link
                text={link.title}
                href={link.url}
                external={link.external}
                icon={link.icon}
              />
            </div>
          ))
        }
      </nav>

      <div class="mt-12 pt-8 border-t border-[#3a3a3a] text-center">
        <p class="text-sm opacity-60">
          Looking for opportunities to create impactful web experiences?
        <a href="/about" class="text-[#ffe895] hover:underline ml-1"
          >Let's connect!</a
        >
        </p>
      </div>
  </article>

  <!-- Cool Background Effects -->
  <div class="floating-particles" id="particles"></div>
  <div class="coding-background" id="codingBg"></div>
  <div class="test-background" id="testBg"></div>
</Layout>

  <script>
    // Typing animation
    const roles = [
      "Software Engineer",
      "Frontend Engineer",
      "Backend Engineer",
    "React.js Developer",
    ];

    let currentRole = 0;
    let currentChar = 0;
    let isDeleting = false;
    const typingElement = document.getElementById("typing-text");
    const typingSpeed = 100;
    const deletingSpeed = 50;
    const pauseTime = 2000;

    function typeWriter() {
      if (!typingElement) return;

      const currentText = roles[currentRole];

      if (isDeleting) {
        typingElement.textContent = currentText.substring(0, currentChar - 1);
        currentChar--;

        if (currentChar === 0) {
          isDeleting = false;
          currentRole = (currentRole + 1) % roles.length;
          setTimeout(typeWriter, 500);
          return;
        }
        setTimeout(typeWriter, deletingSpeed);
      } else {
        typingElement.textContent = currentText.substring(0, currentChar + 1);
        currentChar++;

        if (currentChar === currentText.length) {
          isDeleting = true;
          setTimeout(typeWriter, pauseTime);
          return;
        }
        setTimeout(typeWriter, typingSpeed);
      }
    }

    // Start typing animation after page load
    setTimeout(() => {
      typeWriter();
    }, 1000);

    // Scroll reveal animation
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
        }
      });
    }, observerOptions);

    document.querySelectorAll(".scroll-reveal").forEach((el) => {
      observer.observe(el);
    });

  // Cool floating particles
  function createParticles() {
    const particlesContainer = document.getElementById("particles");
    if (!particlesContainer) return;
    const particleCount = 15;

    for (let i = 0; i < particleCount; i++) {
      const particle = document.createElement("div");
      particle.className = "particle";

      // Random size between 2px and 6px
      const size = Math.random() * 4 + 2;
      particle.style.width = size + "px";
      particle.style.height = size + "px";

      // Random position
      particle.style.left = Math.random() * 100 + "%";
      particle.style.top = Math.random() * 100 + "%";

      // Random animation delay
      particle.style.animationDelay = Math.random() * 15 + "s";
      particle.style.animationDuration = Math.random() * 10 + 10 + "s";

      particlesContainer.appendChild(particle);
    }
  }

  // Cool coding background
  function createCodingBackground() {
    const codingContainer = document.getElementById("codingBg");
    if (!codingContainer) return;

    // Code snippets
    const codeSnippets = [
      `function createPortfolio() {
  const skills = ['React', 'Vue', 'TypeScript'];
  return buildAmazingApp(skills);
}`,
      `const engineer = {
  name: 'Nguyen Hai Trinh',
  role: 'Software Engineer',
  experience: '3+ years'
};`,
      `import { useState, useEffect } from 'react';
const [projects, setProjects] = useState([]);
useEffect(() => {
  fetchProjects().then(setProjects);
}, []);`,
      `class SoftwareEngineer {
  constructor(name, skills) {
    this.name = name;
    this.skills = skills;
  }
  
  build() {
    return 'Amazing software';
  }
}`,
      `const tradingPlatform = {
  charts: 'TradingView',
  realtime: 'WebSocket',
  framework: 'React 19'
};`,
    ];

    // Create code snippets
    for (let i = 0; i < 6; i++) {
      const snippet = document.createElement("div");
      snippet.className = "code-snippet";
      snippet.textContent = codeSnippets[i % codeSnippets.length];

      snippet.style.left = Math.random() * 80 + 10 + "%";
      snippet.style.top = Math.random() * 80 + 10 + "%";
      snippet.style.animationDelay = Math.random() * 25 + "s";
      snippet.style.animationDuration = Math.random() * 15 + 20 + "s";

      codingContainer.appendChild(snippet);
    }

    // Hex codes (thay vì binary)
    for (let i = 0; i < 6; i++) {
      const hex = document.createElement("div");
      hex.className = "binary-stream";

      let hexText = "";
      for (let j = 0; j < 8; j++) {
        hexText += Math.random() > 0.5 ? "A" : "F";
        if (j % 2 === 1) hexText += " ";
      }
      hex.textContent = hexText;

      hex.style.left = Math.random() * 100 + "%";
      hex.style.animationDelay = Math.random() * 20 + "s";
      hex.style.animationDuration = Math.random() * 10 + 15 + "s";

      codingContainer.appendChild(hex);
    }

    // Circuit lines
    for (let i = 0; i < 12; i++) {
      const circuit = document.createElement("div");
      circuit.className = "circuit-line";

      circuit.style.left = Math.random() * 100 + "%";
      circuit.style.top = Math.random() * 100 + "%";
      circuit.style.width = Math.random() * 200 + 100 + "px";
      circuit.style.transform = `rotate(${Math.random() * 360}deg)`;
      circuit.style.animationDelay = Math.random() * 15 + "s";
      circuit.style.animationDuration = Math.random() * 10 + 10 + "s";

      codingContainer.appendChild(circuit);
    }

    // Tech symbols
    const symbols = [
      "</>",
      "{ }",
      "()",
      "[]",
      "=>",
      "++",
      "--",
      "&&",
      "||",
      "==",
      "!=",
      "<=",
      ">=",
      "/*",
      "*/",
      "//",
    ];
    for (let i = 0; i < 15; i++) {
      const symbol = document.createElement("div");
      symbol.className = "tech-symbol";
      symbol.textContent = symbols[i % symbols.length];

      symbol.style.left = Math.random() * 100 + "%";
      symbol.style.top = Math.random() * 100 + "%";
      symbol.style.animationDelay = Math.random() * 30 + "s";
      symbol.style.animationDuration = Math.random() * 20 + 20 + "s";

      codingContainer.appendChild(symbol);
    }

    // API endpoints
    const endpoints = [
      "/api/users",
      "/api/projects",
      "/api/skills",
      "/api/contact",
      "GET /api/data",
      "POST /api/create",
      "PUT /api/update",
      "DELETE /api/remove",
    ];
    for (let i = 0; i < 8; i++) {
      const endpoint = document.createElement("div");
      endpoint.className = "code-snippet";
      endpoint.textContent = endpoints[i % endpoints.length];
      endpoint.style.fontSize = "10px";
      endpoint.style.color = "rgba(255, 119, 198, 0.3)";

      endpoint.style.left = Math.random() * 100 + "%";
      endpoint.style.top = Math.random() * 100 + "%";
      endpoint.style.animationDelay = Math.random() * 25 + "s";
      endpoint.style.animationDuration = Math.random() * 15 + 20 + "s";

      codingContainer.appendChild(endpoint);
    }

    // File extensions
    const extensions = [
      ".js",
      ".ts",
      ".jsx",
      ".tsx",
      ".vue",
      ".html",
      ".css",
      ".scss",
      ".json",
      ".md",
      ".yml",
      ".xml",
    ];
    for (let i = 0; i < 12; i++) {
      const ext = document.createElement("div");
      ext.className = "tech-symbol";
      ext.textContent = extensions[i % extensions.length];
      ext.style.fontSize = "12px";
      ext.style.color = "rgba(120, 119, 198, 0.3)";

      ext.style.left = Math.random() * 100 + "%";
      ext.style.top = Math.random() * 100 + "%";
      ext.style.animationDelay = Math.random() * 30 + "s";
      ext.style.animationDuration = Math.random() * 20 + 20 + "s";

      codingContainer.appendChild(ext);
    }
  }

  // Initialize cool effects
  createParticles();
  createCodingBackground();

  // Magnetic effect for interactive elements
  function addMagneticEffect() {
    const magneticElements = document.querySelectorAll(
      ".magnetic, .magnetic-intense",
    );

    magneticElements.forEach((element) => {
      element.addEventListener("mousemove", (e) => {
        const rect = element.getBoundingClientRect();
        const x = (e as MouseEvent).clientX - rect.left - rect.width / 2;
        const y = (e as MouseEvent).clientY - rect.top - rect.height / 2;

        (element as HTMLElement).style.transform =
          `translate(${x * 0.05}px, ${y * 0.05}px)`;
      });

      element.addEventListener("mouseleave", () => {
        (element as HTMLElement).style.transform = "translate(0, 0)";
      });
    });
  }

  // addMagneticEffect(); // Disabled for better readability
  </script>

  <style>
    .typing-text {
      color: #ffe895;
      font-weight: 600;
    }

    .typing-text::after {
      content: "|";
      color: #ffe895;
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%,
      50% {
        opacity: 1;
      }
      51%,
      100% {
        opacity: 0;
      }
    }
  </style>
