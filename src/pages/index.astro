---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";
import SocialLink from "../components/SocialLink.astro";
import { Icon } from "astro-icon/components";
---

<Layout seo={homePageContent.seo}>
  <article class="mt-6 max-w-4xl mx-auto px-4 sm:px-6 space-y-10">
    
    <!-- Hero Terminal Window -->
    <header class="terminal-window overflow-hidden animate-fadeInDown relative">
      <!-- Terminal Bar -->
      <div class="terminal-header justify-between">
        <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
          <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ff5f56] border border-[#e0443e] shrink-0"></div>
          <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ffbd2e] border border-[#dea123] shrink-0"></div>
          <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#27c93f] border border-[#1aab29] shrink-0"></div>
          <span class="text-[10px] sm:text-xs font-mono-code text-slate-400 ml-1 sm:ml-2 truncate">trinh@milano-starship ~ % ./awesome_mix_init.sh</span>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-[10px] font-mono-code text-amber-300 bg-amber-500/10 border border-amber-400/40 px-3 py-1 rounded-full font-bold">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
          GUARDIANS_FILE // SENIOR SOFTWARE ENGINEER @ COGNISIAN
        </div>
      </div>

      <!-- Hero Main Content Inside Terminal -->
      <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/30 text-xs font-mono-code text-fuchsia-300">
            <span class="text-amber-400">const</span> pilot = <span class="text-cyan-300">"Nguyen Hai Trinh"</span>;
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
            {identity.name}
          </h1>

          <p class="text-lg md:text-xl font-mono-code text-amber-400 font-bold">
            &gt; <span id="typing-text" class="typing-text"></span>
          </p>

          <p class="text-slate-200 text-sm md:text-base leading-relaxed">
            Senior Fullstack Engineer (Go + React) with <strong>4+ years</strong> of experience building high-concurrency web systems, cross-platform mobile apps, and real-time backend microservices across <strong>Fintech, Mortgage Lending, Healthcare, IoT, and Banking</strong>.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="https://hrtool.ethansoftwaredeveloper.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 bg-gradient-to-r from-amber-500 via-fuchsia-600 to-cyan-500 text-white font-mono-code font-bold text-xs tracking-wider uppercase rounded-xl hover:shadow-lg hover:shadow-fuchsia-500/30 transition-all flex items-center gap-2"
            >
              <span>🎵</span> Launch HR-Tool Live ↗
            </a>
            <a
              href="/about"
              class="px-5 py-2.5 bg-slate-900/80 text-amber-300 border border-amber-400/40 hover:bg-amber-400/10 font-mono-code font-bold text-xs tracking-wider uppercase rounded-xl transition-all flex items-center gap-2"
            >
              <span>🚀</span> Explore Cosmic Profile →
            </a>
            {
              homePageContent.homeSocialLinks.map((link) => (
                <SocialLink
                  title={link.title}
                  url={link.url}
                  icon={link.icon}
                  external={link.external}
                />
              ))
            }
          </div>
        </div>

        <div class="md:col-span-4 flex flex-col items-center justify-center">
          <div class="relative group">
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-yellow-400 via-cyan-400 to-pink-500 opacity-90 blur-md group-hover:opacity-100 transition duration-500 animate-pulse"></div>
            <div class="relative cp-cut-corner bg-[#070a12] p-1">
              <Image
                src="/img/me_2.jpg"
                alt="Nguyen Hai Trinh Profile"
                width={180}
                height={180}
                loading="eager"
                decoding="async"
                quality={100}
                densities={[1.5, 2]}
                class="cp-cut-corner object-cover w-[160px] h-[160px] md:w-[170px] md:h-[170px] border border-cyan-400/50"
              />
            </div>
            <div class="absolute -bottom-2 -right-2 bg-gradient-to-r from-amber-400 to-fuchsia-500 text-black text-[9px] font-mono-code font-extrabold px-2.5 py-0.5 rounded-full shadow-md">
              STAR_LORD // PILOT
            </div>
          </div>
          <div class="mt-4 text-center">
            <p class="text-xs font-mono-code text-cyan-300 font-bold">Ho Chi Minh City, VN 🇻🇳</p>
            <p class="text-[11px] font-mono-code text-yellow-300/90">B.S. Software Engineering</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Flagship AI Platforms Section -->
    <section class="space-y-6 animate-fadeInUp delay-200 mt-4">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <h2 class="text-lg md:text-xl font-bold text-white font-mono-code flex items-center gap-2">
          <span class="text-cyan-400">🔥</span> Flagship Platforms
        </h2>
        <a href="/about" class="text-xs font-mono-code text-cyan-400 hover:underline">View All →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- JARVIS -->
        <div class="relative bg-[#0a0c16]/80 backdrop-blur-xl border border-indigo-500/30 shadow-[0_0_30px_rgba(99,102,241,0.1)] rounded-2xl p-6 hover:-translate-y-1 transition-transform duration-300 group overflow-hidden flex flex-col h-full">
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>
          
          <div class="flex items-start gap-4 mb-4 relative z-10">
            <div class="p-3 rounded-xl bg-indigo-500/10 border border-indigo-500/20 shrink-0">
              <img src="/img/jarvis_logo.svg" alt="JARVIS" class="w-8 h-8 object-contain drop-shadow-[0_0_8px_rgba(99,102,241,0.5)]" />
            </div>
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors">J.A.R.V.I.S. AI Agent</h3>
              <p class="text-xs font-mono-code text-indigo-300 mt-1">Go 1.25 • Fastify • MongoDB Vector</p>
            </div>
          </div>
          
          <p class="text-sm text-slate-300 leading-relaxed flex-grow relative z-10">
            Self-built autonomous AI Agent platform featuring a custom Go ReAct runtime, multi-agent orchestration, MCP client/server, and 3-tier memory. Auto-fallback routing between DeepSeek, Gemini, and Claude.
          </p>
          
          <div class="mt-6 flex items-center gap-3 relative z-10">
            <a href="https://ai.ethansoftwaredeveloper.com/" target="_blank" class="px-5 py-2.5 rounded-xl bg-indigo-600/20 border border-indigo-500/30 hover:bg-indigo-600 hover:border-indigo-500 text-indigo-300 hover:text-white font-mono-code text-xs font-bold transition-all flex items-center gap-2">
              Launch App ↗
            </a>
          </div>
        </div>

        <!-- HR-Tool -->
        <div class="relative bg-[#0a0c16]/80 backdrop-blur-xl border border-fuchsia-500/30 shadow-[0_0_30px_rgba(217,70,239,0.1)] rounded-2xl p-6 hover:-translate-y-1 transition-transform duration-300 group overflow-hidden flex flex-col h-full">
          <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="absolute top-0 right-0 w-32 h-32 bg-fuchsia-500/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>
          
          <div class="flex items-start gap-4 mb-4 relative z-10">
            <div class="p-3.5 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 text-2xl leading-none flex items-center justify-center shrink-0">
              🚀
            </div>
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-fuchsia-400 transition-colors">HR-Tool SaaS</h3>
              <p class="text-xs font-mono-code text-fuchsia-300 mt-1">React 19 • Go/Gin • Nest.js</p>
            </div>
          </div>
          
          <p class="text-sm text-slate-300 leading-relaxed flex-grow relative z-10">
            Multi-tenant HR/ATS platform supporting enterprise recruitment agencies with 4-tier RBAC, real-time Docker SSE container monitoring, and an AI candidate-job matching engine.
          </p>
          
          <div class="mt-6 flex items-center gap-3 relative z-10">
            <a href="https://hrtool.ethansoftwaredeveloper.com/" target="_blank" class="px-5 py-2.5 rounded-xl bg-fuchsia-600/20 border border-fuchsia-500/30 hover:bg-fuchsia-600 hover:border-fuchsia-500 text-fuchsia-300 hover:text-white font-mono-code text-xs font-bold transition-all flex items-center gap-2">
              Launch App ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Skill Matrix Grid with Icons -->
    <section class="cyber-card p-6 md:p-8 rounded-2xl space-y-6">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-white font-mono-code flex items-center gap-2">
          <span class="text-indigo-400">🛠️</span> Primary Tech Stack & Frameworks
        </h3>
        <a href="/skills" class="text-xs font-mono-code text-cyan-400 hover:underline">View Full Arsenal →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- React & Frontend -->
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
          <div class="flex items-center gap-2 text-cyan-400 font-mono-code text-xs font-semibold">
            <Icon name="logos:react" width={18} height={18} />
            <span>REACT ECOSYSTEM</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold">
              <Icon name="logos:react" width={14} height={14} />
              React
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-slate-800 text-slate-200 border border-white/10 font-semibold">
              <Icon name="logos:nextjs-icon" width={14} height={14} />
              Next.js (App Router, Page Router)
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 font-semibold">
              <Icon name="logos:vue" width={14} height={14} />
              Vue 3
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-purple-500/10 text-purple-300 border border-purple-500/30 font-semibold">
              <Icon name="logos:astro-icon" width={14} height={14} />
              Astro.js
            </span>
          </div>
        </div>

        <!-- Nest.js & Backend -->
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
          <div class="flex items-center gap-2 text-purple-400 font-mono-code text-xs font-semibold">
            <Icon name="logos:nestjs" width={18} height={18} />
            <span>BACKEND SERVICES</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-purple-500/10 text-purple-300 border border-purple-500/30 font-semibold">
              <Icon name="logos:nestjs" width={14} height={14} />
              Nest.js
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold">
              <Icon name="logos:go" width={14} height={14} />
              Go (Gin)
            </span>
          </div>
        </div>

        <!-- Languages & Tools -->
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
          <div class="flex items-center gap-2 text-indigo-400 font-mono-code text-xs font-semibold">
            <Icon name="logos:typescript-icon" width={18} height={18} />
            <span>LANGUAGES & TOOLING</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-indigo-500/10 text-indigo-300 border border-indigo-500/30 font-semibold">
              <Icon name="logos:typescript-icon" width={14} height={14} />
              TypeScript
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold">
              <Icon name="logos:tailwindcss-icon" width={14} height={14} />
              Tailwind CSS
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 font-semibold">
              <Icon name="logos:docker-icon" width={14} height={14} />
              Docker
            </span>
          </div>
        </div>
      </div>
    </section>

  </article>
</Layout>

<script>
  // Typing animation for roles
  const roles = [
    "Senior Software Engineer",
    "Senior Fullstack Engineer (Go + React)",
    "Senior Frontend Engineer",
    "Backend Engineer",
  ];

  let currentRole = 0;
  let currentChar = 0;
  let isDeleting = false;
  const typingElement = document.getElementById("typing-text");
  const typingSpeed = 80;
  const deletingSpeed = 40;
  const pauseTime = 1800;

  function typeWriter() {
    if (!typingElement) return;

    const currentText = roles[currentRole];

    if (isDeleting) {
      typingElement.textContent = currentText.substring(0, currentChar - 1);
      currentChar--;

      if (currentChar === 0) {
        isDeleting = false;
        currentRole = (currentRole + 1) % roles.length;
        setTimeout(typeWriter, 400);
        return;
      }
      setTimeout(typeWriter, deletingSpeed);
    } else {
      typingElement.textContent = currentText.substring(0, currentChar + 1);
      currentChar++;

      if (currentChar === currentText.length) {
        isDeleting = true;
        setTimeout(typeWriter, pauseTime);
        return;
      }
      setTimeout(typeWriter, typingSpeed);
    }
  }

  setTimeout(() => {
    typeWriter();
  }, 600);
</script>

<style>
  .typing-text {
    color: #ffe895;
    font-weight: 600;
  }

  .typing-text::after {
    content: "|";
    color: #ffe895;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }
</style>
