---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";
import SocialLink from "../components/SocialLink.astro";
import { Icon } from "astro-icon/components";
---

<Layout seo={homePageContent.seo}>
  <article class="mt-6 max-w-4xl mx-auto px-4 sm:px-6 space-y-10">
    
    <!-- Hero Terminal Window -->
    <header class="terminal-window overflow-hidden animate-fadeInDown relative">
      <!-- Terminal Bar -->
      <div class="terminal-header justify-between">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-[#ff5f56] border border-[#e0443e]"></div>
          <div class="w-3 h-3 rounded-full bg-[#ffbd2e] border border-[#dea123]"></div>
          <div class="w-3 h-3 rounded-full bg-[#27c93f] border border-[#1aab29]"></div>
          <span class="text-xs font-mono-code text-slate-400 ml-2">trinh@loanfactory-macbook ~ % ./init_profile.sh</span>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-[10px] font-mono-code text-black cp-badge-yellow px-3 py-1 rounded">
          <span class="w-2 h-2 rounded-full bg-black animate-ping"></span>
          SYS_STATUS // SENIOR FULLSTACK @ LOAN FACTORY
        </div>
      </div>

      <!-- Hero Main Content Inside Terminal -->
      <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-yellow-400/10 border border-yellow-400/30 text-xs font-mono-code text-yellow-300">
            <span class="text-cyan-400">const</span> engineer = <span class="text-emerald-400">"Nguyen Hai Trinh"</span>;
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
            {identity.name}
          </h1>

          <p class="text-lg md:text-xl font-mono-code text-cyan-400 font-semibold">
            &gt; <span id="typing-text" class="typing-text"></span>
          </p>

          <p class="text-slate-300 text-sm md:text-base leading-relaxed">
            Senior Fullstack Engineer (Go + React) with <strong>4+ years</strong> of experience building high-concurrency web systems, cross-platform mobile apps, and real-time backend microservices across <strong>Fintech, Mortgage Lending, Healthcare, IoT, and Banking</strong>.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="https://hr-tool-software.netlify.app"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 bg-[#fcee09] text-black font-mono-code font-bold text-xs tracking-wider uppercase hover:bg-yellow-300 transition-all cp-cut-corner-sm flex items-center gap-2 shadow-lg shadow-yellow-400/20"
            >
              <span>🚀</span> Launch HR-Tool Live ↗
            </a>
            <a
              href="/about"
              class="px-5 py-2.5 bg-slate-800 text-cyan-300 border border-cyan-500/40 hover:bg-cyan-500/10 font-mono-code font-bold text-xs tracking-wider uppercase transition-all cp-cut-corner-sm flex items-center gap-2"
            >
              <span>👤</span> Access Profile HUD →
            </a>
            {
              homePageContent.homeSocialLinks.map((link) => (
                <SocialLink
                  title={link.title}
                  url={link.url}
                  icon={link.icon}
                  external={link.external}
                />
              ))
            }
          </div>
        </div>

        <div class="md:col-span-4 flex flex-col items-center justify-center">
          <div class="relative group">
            <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-cyan-500 via-indigo-500 to-purple-500 opacity-75 blur-md group-hover:opacity-100 transition duration-500"></div>
            <Image
              src="/img/me_2.jpg"
              alt="Nguyen Hai Trinh Profile"
              width={180}
              height={180}
              loading="eager"
              decoding="async"
              quality={100}
              densities={[1.5, 2]}
              class="relative rounded-xl border-2 border-slate-950 object-cover w-[160px] h-[160px] md:w-[170px] md:h-[170px]"
            />
          </div>
          <div class="mt-3 text-center">
            <p class="text-xs font-mono-code text-slate-400">Ho Chi Minh City, VN 🇻🇳</p>
            <p class="text-[11px] font-mono-code text-indigo-400">B.S. Software Engineering</p>
          </div>
        </div>
      </div>
    </header>

    <!-- Engineering Impact Stats Grid -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 animate-fadeInUp delay-200">
      <div class="cyber-card p-4 rounded-xl text-center space-y-1">
        <p class="text-2xl md:text-3xl font-extrabold font-mono-code text-cyan-400">4+ Yrs</p>
        <p class="text-xs text-slate-300">Engineering Experience</p>
      </div>

      <div class="cyber-card p-4 rounded-xl text-center space-y-1">
        <p class="text-2xl md:text-3xl font-extrabold font-mono-code text-indigo-400">~250ms</p>
        <p class="text-xs text-slate-300">StarRocks OLAP Latency</p>
      </div>

      <div class="cyber-card p-4 rounded-xl text-center space-y-1">
        <p class="text-2xl md:text-3xl font-extrabold font-mono-code text-emerald-400">20K+</p>
        <p class="text-xs text-slate-300">OHLC Trading Records/Sec</p>
      </div>

      <div class="cyber-card p-4 rounded-xl text-center space-y-1">
        <p class="text-2xl md:text-3xl font-extrabold font-mono-code text-purple-400">55+ PRs</p>
        <p class="text-xs text-slate-300">HR-Tool Solo SaaS</p>
      </div>
    </section>

    <!-- Live Code Showcase / Architecture Spotlight -->
    <section class="terminal-window p-6 space-y-4 animate-fadeInLeft delay-400">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <h2 class="text-base font-bold text-white font-mono-code flex items-center gap-2">
          <span class="text-cyan-400">⚡</span> Live Code Architecture Spotlight
        </h2>
        <span class="text-xs font-mono-code text-slate-400">React 19 • Go/Gin • Nest.js • tRPC</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-stretch">
        <div class="bg-[#030611] p-4 rounded-xl border border-white/10 font-mono-code text-xs space-y-2 overflow-x-auto">
          <div class="flex items-center justify-between text-slate-500 pb-1 border-b border-white/5">
            <span>// Cognisian & HR-Tool AI Stack</span>
            <span class="text-cyan-400">TypeScript</span>
          </div>
          <p class="text-purple-400">import <span class="text-white">&#123; generateAiMatch &#125;</span> from <span class="text-emerald-300">'@ai/matcher'</span>;</p>
          <p class="text-indigo-300">export async function <span class="text-cyan-300">scoreCandidate</span>(cv, job) &#123;</p>
          <p class="pl-4 text-slate-300">const <span class="text-yellow-300">result</span> = await <span class="text-cyan-300">generateAiMatch</span>(&#123;</p>
          <p class="pl-8 text-slate-400">providers: [<span class="text-emerald-300">'Claude-4.8-Opus'</span>, <span class="text-emerald-300">'Gemini-3.6-Flash'</span>],</p>
          <p class="pl-8 text-slate-400">criteria: [<span class="text-emerald-300">'skills'</span>, <span class="text-emerald-300">'exp'</span>, <span class="text-emerald-300">'architecture'</span>]</p>
          <p class="pl-4 text-slate-300">&#125;);</p>
          <p class="pl-4 text-purple-400">return <span class="text-slate-300">result.score;</span></p>
          <p class="text-indigo-300">&#125;</p>
        </div>

        <div class="cyber-card p-5 rounded-xl flex flex-col justify-between space-y-4">
          <div>
            <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
              <span class="text-emerald-400">🚀</span> HR-Tool Solo Multi-Tenant SaaS
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Multi-tenant HR/ATS platform supporting enterprise HR & recruitment agencies, 4-tier RBAC, real-time Docker SSE container monitoring, and AI candidate matching.
            </p>
          </div>

          <div class="flex items-center gap-3 pt-2">
            <a
              href="https://hr-tool-software.netlify.app"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-lg bg-gradient-to-r from-cyan-500 to-indigo-600 text-white font-mono-code text-xs font-semibold hover:shadow-lg hover:shadow-cyan-500/25 transition-all flex items-center gap-1.5"
            >
              Launch Live App ↗
            </a>
            <a
              href="/about"
              class="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 font-mono-code text-xs transition-colors"
            >
              View Full Career →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Skill Matrix Grid with Icons -->
    <section class="cyber-card p-6 md:p-8 rounded-2xl space-y-6">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-white font-mono-code flex items-center gap-2">
          <span class="text-indigo-400">🛠️</span> Primary Tech Stack & Frameworks
        </h3>
        <a href="/skills" class="text-xs font-mono-code text-cyan-400 hover:underline">View Full Arsenal →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- React & Frontend -->
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
          <div class="flex items-center gap-2 text-cyan-400 font-mono-code text-xs font-semibold">
            <Icon name="logos:react" width={18} height={18} />
            <span>REACT ECOSYSTEM</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold">
              <Icon name="logos:react" width={14} height={14} />
              React
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-slate-800 text-slate-200 border border-white/10 font-semibold">
              <Icon name="logos:nextjs-icon" width={14} height={14} />
              Next.js (App Router, Page Router)
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 font-semibold">
              <Icon name="logos:vue" width={14} height={14} />
              Vue 3
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-purple-500/10 text-purple-300 border border-purple-500/30 font-semibold">
              <Icon name="logos:astro-icon" width={14} height={14} />
              Astro.js
            </span>
          </div>
        </div>

        <!-- Nest.js & Backend -->
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
          <div class="flex items-center gap-2 text-purple-400 font-mono-code text-xs font-semibold">
            <Icon name="logos:nestjs" width={18} height={18} />
            <span>BACKEND SERVICES</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-purple-500/10 text-purple-300 border border-purple-500/30 font-semibold">
              <Icon name="logos:nestjs" width={14} height={14} />
              Nest.js
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold">
              <Icon name="logos:go" width={14} height={14} />
              Go (Gin)
            </span>
          </div>
        </div>

        <!-- Languages & Tools -->
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
          <div class="flex items-center gap-2 text-indigo-400 font-mono-code text-xs font-semibold">
            <Icon name="logos:typescript-icon" width={18} height={18} />
            <span>LANGUAGES & TOOLING</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-indigo-500/10 text-indigo-300 border border-indigo-500/30 font-semibold">
              <Icon name="logos:typescript-icon" width={14} height={14} />
              TypeScript
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold">
              <Icon name="logos:tailwindcss-icon" width={14} height={14} />
              Tailwind CSS
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono-code rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 font-semibold">
              <Icon name="logos:docker-icon" width={14} height={14} />
              Docker
            </span>
          </div>
        </div>
      </div>
    </section>

  </article>
</Layout>

<script>
  // Typing animation for roles
  const roles = [
    "Senior Software Engineer",
    "Senior Fullstack Engineer (Go + React)",
    "Senior Frontend Engineer",
    "Backend Engineer",
  ];

  let currentRole = 0;
  let currentChar = 0;
  let isDeleting = false;
  const typingElement = document.getElementById("typing-text");
  const typingSpeed = 80;
  const deletingSpeed = 40;
  const pauseTime = 1800;

  function typeWriter() {
    if (!typingElement) return;

    const currentText = roles[currentRole];

    if (isDeleting) {
      typingElement.textContent = currentText.substring(0, currentChar - 1);
      currentChar--;

      if (currentChar === 0) {
        isDeleting = false;
        currentRole = (currentRole + 1) % roles.length;
        setTimeout(typeWriter, 400);
        return;
      }
      setTimeout(typeWriter, deletingSpeed);
    } else {
      typingElement.textContent = currentText.substring(0, currentChar + 1);
      currentChar++;

      if (currentChar === currentText.length) {
        isDeleting = true;
        setTimeout(typeWriter, pauseTime);
        return;
      }
      setTimeout(typeWriter, typingSpeed);
    }
  }

  setTimeout(() => {
    typeWriter();
  }, 600);
</script>

<style>
  .typing-text {
    color: #ffe895;
    font-weight: 600;
  }

  .typing-text::after {
    content: "|";
    color: #ffe895;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }
</style>
