---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";
import SocialLink from "../components/SocialLink.astro";
import Link from "../components/Link.astro";
---

<Layout seo={homePageContent.seo}>
  <!-- Floating particles background -->
  <div class="floating-particles">
    <div
      class="particle"
      style="top: 10%; left: 10%; width: 4px; height: 4px; animation-delay: 0s;"
    >
    </div>
    <div
      class="particle"
      style="top: 20%; right: 20%; width: 6px; height: 6px; animation-delay: 2s;"
    >
    </div>
    <div
      class="particle"
      style="top: 50%; left: 5%; width: 3px; height: 3px; animation-delay: 4s;"
    >
    </div>
    <div
      class="particle"
      style="bottom: 30%; right: 10%; width: 5px; height: 5px; animation-delay: 6s;"
    >
    </div>
    <div
      class="particle"
      style="bottom: 10%; left: 30%; width: 4px; height: 4px; animation-delay: 1s;"
    >
    </div>
  </div>

  <article class="mt-10 max-w-2xl mx-auto px-6">
    <header class="animate-fadeInDown">
      <h1 class="text-3xl mb-1">{identity.name}</h1>
      <p class="opacity-60 mb-10 subtitle">
        <span id="typing-text" class="typing-text"></span>
        <span
          class="lazy-badge inline-flex items-center bg-[#2a2a2a] text-[#ffe895] text-xs font-semibold ml-2 px-2.5 py-0.5 rounded-full border border-[#3a3a3a]"
        >
          <span
            class="inline-block w-2 h-2 rounded-full bg-[#00abda] mr-1.5 pulse-dot"
          ></span>
          Open for freelance/ Remote opportunities
        </span>
      </p>
    </header>

    <section class="flex flex-col md:flex-row gap-8 mb-12 animate-fadeInLeft delay-200">
      <div class="flex-shrink-0">
        <div class="relative group">
          <Image
            src="/img/Ethan_Nguyen_2.jpg"
            alt="Professional portrait of Hai Trinh (Ethan Nguyen), Software Engineer specializing in React.js and Frontend Development"
            width={150}
            height={150}
            loading="eager"
            decoding="async"
            quality={100}
            densities={[1.5, 2]}
            class="rounded-xl border-2 border-[#3a3a3a] border-opacity-80 profile-image hover-glow transition-all duration-300 filter hover:brightness-110"
          />
          <div class="absolute inset-0 rounded-xl bg-gradient-to-r from-blue-500/20 to-purple-500/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
        
        <nav
          class="mt-4 flex flex-row md:flex-col justify-center gap-2 w-fit social-bar"
          aria-label="Social media links"
        >
          {
            homePageContent.homeSocialLinks.map((link, index) => (
              <div class={`social-item delay-${(index + 1) * 100}`}>
                <SocialLink
                  title={link.title}
                  url={link.url}
                  icon={link.icon}
                  external={link.external}
                />
              </div>
            ))
          }
        </nav>
      </div>

      <div class="flex-grow space-y-6 animate-fadeInRight delay-400">
        <div class="bg-gradient-to-r from-[#2a2a2a] to-[#1a1a1a] p-6 rounded-xl border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all duration-300 scroll-reveal">
          <h2 class="text-xl font-bold mb-4 text-[#ffe895]">👋 Hey there!</h2>
          <p class="leading-relaxed">
            I'm a <strong>Software Engineer</strong> with 3+ years of experience crafting exceptional digital experiences. I specialize in building scalable UI systems using <strong class="text-blue-400">React</strong>, <strong class="text-blue-400">Next.js</strong>, and <strong class="text-blue-400">TypeScript</strong>.
          </p>
        </div>

        <div class="space-y-4 scroll-reveal">
          <h3 class="text-lg font-semibold text-[#ffe895]">🚀 Recent Achievements</h3>
          <ul class="space-y-2 list-none">
            <li class="flex items-start gap-2">
              <span class="text-blue-400">▹</span>
              Built a real-time commodity trading platform integrated with Vietnam Commodity Exchange (MXV)
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400">▹</span>
              Led frontend architecture for KOMO's beauty service booking ecosystem
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400">▹</span>
              Optimized application performance, reducing load times by 40%
            </li>
          </ul>
        </div>

        <div class="scroll-reveal space-y-6">
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[#ffe895]">🛠️ Tech Stack</h3>
            <div class="space-y-4">
              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">Frontend Development</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">React.js</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Next.js</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">TypeScript</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Vue.js</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Redux Toolkit</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">TanStack Query</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Material UI</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Tailwind CSS</span>
                </div>
              </div>

              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">Mobile Development</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Flutter</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">React Native</span>
                </div>
              </div>

              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">Backend & APIs</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Java</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Spring Boot</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Node.js</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Express</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">GraphQL</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">REST APIs</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Socket.io</span>
                </div>
              </div>

              <div>
                <h4 class="text-sm font-medium mb-2 text-blue-400">Development & Tools</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Git</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Docker</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">CI/CD</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Vite</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Rsbuild</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Rspack</span>
                  <span class="px-3 py-1 bg-[#2a2a2a] rounded-full text-sm border border-[#3a3a3a] hover:border-[#4a4a4a] transition-all">Jest</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-4 scroll-reveal">
          <p class="text-sm opacity-80">
            When I'm not coding, you'll find me debugging with ☕, exploring new tech 🧠, and staying active at the gym 💪
          </p>
        </div>
      </div>
    </section>

      <nav
        class="flex flex-wrap items-center gap-4 group w-fit mt-8 animate-fadeInUp delay-600"
        aria-label="Navigation links"
      >
        {
          homePageContent.links.map((link, index) => (
            <div class={`hover-lift delay-${(index + 1) * 100}`}>
              <Link
                text={link.title}
                href={link.url}
                external={link.external}
                icon={link.icon}
              />
            </div>
          ))
        }
      </nav>

      <div class="mt-12 pt-8 border-t border-[#3a3a3a] text-center">
        <p class="text-sm opacity-60">
          Looking for opportunities to create impactful web experiences?
          <a href="/about" class="text-[#ffe895] hover:underline ml-1">Let's connect!</a>
        </p>
      </div>
    </section>
  </article>

  <script>
    // Typing animation
    const roles = [
      "Software Engineer",
      "Frontend Engineer",
      "Backend Engineer",
      "Full-stack Developer",
      "React.js Specialist",
      "TypeScript Developer",
    ];

    let currentRole = 0;
    let currentChar = 0;
    let isDeleting = false;
    const typingElement = document.getElementById("typing-text");
    const typingSpeed = 100;
    const deletingSpeed = 50;
    const pauseTime = 2000;

    function typeWriter() {
      if (!typingElement) return;

      const currentText = roles[currentRole];

      if (isDeleting) {
        typingElement.textContent = currentText.substring(0, currentChar - 1);
        currentChar--;

        if (currentChar === 0) {
          isDeleting = false;
          currentRole = (currentRole + 1) % roles.length;
          setTimeout(typeWriter, 500);
          return;
        }
        setTimeout(typeWriter, deletingSpeed);
      } else {
        typingElement.textContent = currentText.substring(0, currentChar + 1);
        currentChar++;

        if (currentChar === currentText.length) {
          isDeleting = true;
          setTimeout(typeWriter, pauseTime);
          return;
        }
        setTimeout(typeWriter, typingSpeed);
      }
    }

    // Start typing animation after page load
    setTimeout(() => {
      typeWriter();
    }, 1000);

    // Scroll reveal animation
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
        }
      });
    }, observerOptions);

    document.querySelectorAll(".scroll-reveal").forEach((el) => {
      observer.observe(el);
    });
  </script>

  <style>
    .typing-text {
      color: #ffe895;
      font-weight: 600;
    }

    .typing-text::after {
      content: "|";
      color: #ffe895;
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%,
      50% {
        opacity: 1;
      }
      51%,
      100% {
        opacity: 0;
      }
    }
  </style>
</Layout>
