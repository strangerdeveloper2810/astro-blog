---
import Layout from "../layouts/Layout.astro";
import SkillsCategory from "../components/SkillsCategory.astro";
import { skillsPageContent } from "../config/skills";
import { Icon } from "astro-icon/components";
---

<Layout seo={skillsPageContent.seo}>
  <div class="relative px-6 py-12">
    <!-- Enhanced background decorations -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute -top-40 -right-40 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl float-animation"
      >
      </div>
      <div
        class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl float-reverse"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-green-500/3 rounded-full blur-3xl rotate-slow"
      >
      </div>
    </div>

    <!-- Floating particles background -->
    <div class="floating-particles">
      <div
        class="particle"
        style="top: 20%; left: 10%; width: 5px; height: 5px; animation-delay: 0s;"
      >
      </div>
      <div
        class="particle"
        style="top: 30%; right: 15%; width: 3px; height: 3px; animation-delay: 2s;"
      >
      </div>
      <div
        class="particle"
        style="top: 70%; left: 20%; width: 4px; height: 4px; animation-delay: 4s;"
      >
      </div>
      <div
        class="particle"
        style="bottom: 20%; right: 25%; width: 6px; height: 6px; animation-delay: 6s;"
      >
      </div>
      <div
        class="particle"
        style="bottom: 40%; left: 15%; width: 3px; height: 3px; animation-delay: 1s;"
      >
      </div>
      <div
        class="particle"
        style="top: 60%; right: 30%; width: 4px; height: 4px; animation-delay: 3s;"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto relative">
      <!-- Header Section -->
      <header class="text-center mb-16 animate-fadeInDown">
        <!-- Title with gradient and enhanced animation -->
        <h1
          class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent leading-tight hover:scale-105 transition-transform duration-300"
        >
          {skillsPageContent.title}
        </h1>

        <!-- Subtitle with scroll reveal -->
        <p
          class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed scroll-reveal"
        >
          {skillsPageContent.subtitle}
        </p>

        <!-- Animated divider -->
        <div class="mt-8 flex justify-center scroll-reveal">
          <div
            class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full"
          >
          </div>
        </div>
      </header>

      <!-- Skills Categories with enhanced animations -->
      <main data-stagger="200">
        {
          skillsPageContent.categories.map((category, index) => (
            <div class={`animate-fadeInUp delay-${(index + 1) * 200}`}>
              <SkillsCategory category={category} index={index} />
            </div>
          ))
        }
      </main>

      <!-- Enhanced Bottom Note Section -->
      <section
        class="text-center mt-16 py-12 bg-gray-50 dark:bg-gray-800/50 rounded-2xl hover-lift animate-fadeInUp delay-800 scroll-reveal"
      >
        <div class="mb-4">
          <Icon
            name="mdi:lightbulb"
            width={48}
            height={48}
            class="mx-auto text-yellow-500 animate-pulse"
          />
        </div>
        <p
          class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed"
        >
          I believe in continuous learning and staying updated with evolving
          technologies. These skills represent my journey in software
          development and my commitment to building quality applications.
        </p>
      </section>
    </div>
  </div>

  <script>
    // Additional page-specific animations
    document.addEventListener("DOMContentLoaded", () => {
      // Add hover effects to skill categories
      const categories = document.querySelectorAll('section[class*="mb-16"]');
      categories.forEach((category) => {
        category.addEventListener("mouseenter", () => {
          category.style.transform = "translateY(-5px)";
        });
        category.addEventListener("mouseleave", () => {
          category.style.transform = "translateY(0)";
        });
      });

      // Add parallax effect to background elements
      window.addEventListener("scroll", () => {
        const scrolled = window.pageYOffset;
        const parallax = document.querySelectorAll(
          ".float-animation, .float-reverse",
        );
        const speed = 0.5;

        parallax.forEach((element) => {
          const yPos = -(scrolled * speed);
          element.style.transform = `translateY(${yPos}px)`;
        });
      });
    });
  </script>
</Layout>

<style>
  /* Additional custom animations */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .float-animation {
    animation: float 6s ease-in-out infinite;
  }
</style>
