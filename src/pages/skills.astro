---
import Layout from "../layouts/Layout.astro";
import SkillsCategory from "../components/SkillsCategory.astro";
import { skillsPageContent } from "../config/skills";
import { Icon } from "astro-icon/components";
---

<Layout seo={skillsPageContent.seo}>
  <div class="relative px-6 py-12">
    <!-- Background decorations -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute -top-40 -right-40 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto relative">
      <!-- Header Section -->
      <header class="text-center mb-16">
        <!-- Title with gradient -->
        <h1
          class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent leading-tight"
        >
          {skillsPageContent.title}
        </h1>

        <!-- Subtitle -->
        <p
          class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed"
        >
          {skillsPageContent.subtitle}
        </p>
      </header>

      <!-- Skills Categories -->
      <main>
        {
          skillsPageContent.categories.map((category, index) => (
            <SkillsCategory category={category} index={index} />
          ))
        }
      </main>

      <!-- Bottom Note Section -->
      <section
        class="text-center mt-16 py-12 bg-gray-50 dark:bg-gray-800/50 rounded-2xl"
      >
        <p
          class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed"
        >
          I believe in continuous learning and staying updated with evolving
          technologies. These skills represent my journey in software
          development and my commitment to building quality applications.
        </p>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* Additional custom animations */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .float-animation {
    animation: float 6s ease-in-out infinite;
  }
</style>
