---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { aboutPageContent, featuredPosts } from "../config";
import ResumeItem from "../components/ResumeItem.astro";
import SocialLinkBox from "../components/SocialLinkBox.astro";
---

<Layout seo={aboutPageContent.seo}>
  <section class="mt-10 max-w-2xl mx-auto px-6">
    <div class="animate-fadeInDown">
      <h1 class="text-3xl mb-1">About</h1>
      <p class="opacity-60 mb-10 subtitle">{aboutPageContent.subtitle}</p>
    </div>

    <div class="mb-14 animate-fadeInUp delay-200">
      <p class="mb-5 sm:text-left scroll-reveal">
        Hello 👋, I'm <span class="font-bold">Nguyen Hai Trinh</span>, a
        goal-oriented Software Engineer based in Ho Chi Minh City 🇻🇳. With 4+
        years of experience, I specialize in building scalable web applications
        and leading frontend teams. Currently, I'm leading frontend development
        for AI-powered healthcare products, working hands-on across web, mobile,
        and backend development.
      </p>

      <p class="mb-5 sm:text-left scroll-reveal">
        I've had the privilege of working across diverse sectors - from
        AI-powered healthcare platforms and derivatives trading systems to
        SaaS booking platforms, banking systems, and IoT solutions. My expertise
        lies in architecting scalable systems using <span class="gradient-link"
          >React.js, React Native, Next.js, Vue.js, TypeScript</span
        >, and I'm actively working with backend technologies like <span
          class="gradient-link">Go, Gin, and Node.js</span
        >.
      </p>

      <div class="mb-5 sm:text-left scroll-reveal">
        <h3 class="text-xl font-semibold mb-2">🎯 Career Goals:</h3>
        <ul class="list-disc ml-6 space-y-2">
          <li>
            <strong>3 years:</strong> Become a Senior Software Engineer, mastering
            system design and leading engineering best practices across full stack
          </li>
          <li>
            <strong>5 years:</strong> Take on the role of a Tech Lead, driving product
            and engineering decisions at scale
          </li>
          <li>
            <strong>7-10 years:</strong> Grow into a Software Architect or Engineering
            Manager, designing robust, scalable systems across large-scale platforms
          </li>
        </ul>
      </div>

      <div class="mb-5 sm:text-left scroll-reveal">
        <h3 class="text-xl font-semibold mb-2">🚀 Key Achievements:</h3>
        <ul class="list-disc ml-6 space-y-2">
          <li>
            Leading frontend development for AI-powered healthcare products with
            React, React Native, and Go backend integration
          </li>
          <li>
            Built real-time commodities trading platform with TradingView
            Advanced Charts and WebSocket communication
          </li>
          <li>
            Led frontend team for KOMO Booking & Admin SaaS platforms serving
            multiple salon chains across Australia
          </li>
          <li>
            Designed and implemented automation testing with Playwright for
            production reliability
          </li>
          <li>Developed IoT solutions for smart building management systems</li>
          <li>
            Contributed to banking systems for Japanese financial conglomerates
          </li>
        </ul>
      </div>

      <p class="mb-5 sm:text-left scroll-reveal">
        My technical toolkit includes modern technologies like <strong
          >React.js (v19)</strong
        >, <strong>React Native</strong>, <strong>Vue.js (v3)</strong>, <strong
          >TypeScript</strong
        >, <strong>Go & Gin</strong>, <strong>GraphQL</strong>, <strong
          >TradingView Advanced Charts</strong
        >, <strong>WebSocket</strong>, <strong>Playwright</strong>, <strong
          >TailwindCSS</strong
        >, <strong>MUI</strong>, <strong>PostgreSQL</strong>, and <strong
          >Docker</strong
        >. I'm passionate about clean code architecture, performance
        optimization, automation testing, and creating delightful user
        experiences.
      </p>

      <p class="mb-5 sm:text-left scroll-reveal">
        Beyond coding, I'm an avid learner 🧠, coffee enthusiast ☕, and fitness
        advocate 💪. I believe in continuous improvement and staying updated
        with the latest tech trends while maintaining a healthy work-life
        balance.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row animate-fadeInLeft delay-400">
      <Image
        id="about-image-left"
        src={aboutPageContent.about.image_l.url}
        alt={aboutPageContent.about.image_l.alt}
        width={350}
        height={250}
        loading="lazy"
        decoding="async"
        quality={100}
        densities={[1.5, 2]}
        class="w-[350px] h-[250px] object-cover rounded-xl sm:-rotate-6 sm:block image-effect profile-image hover-glow"
      />
      <Image
        id="about-image-right"
        src={aboutPageContent.about.image_r.url}
        alt={aboutPageContent.about.image_r.alt}
        width={150}
        height={250}
        loading="lazy"
        decoding="async"
        quality={100}
        densities={[1.5, 2]}
        class="hidden w-[150px] h-[250px] object-cover rounded-xl rotate-6 mx-auto sm:ml-auto sm:block image-effect profile-image hover-glow delay-200"
      />
    </div>
  </section>

  <section
    class="my-20 mt-32 max-w-2xl mx-auto px-6 sm:flex sm:gap-16 animate-fadeInUp delay-600"
  >
    <h2 class="mb-8 sm:mb-0 opacity-60 navbar">Experience</h2>
    <div>
      <div class="mb-8 scroll-reveal">
        <h3 class="text-xl font-semibold mb-4">Featured Projects</h3>
        <div class="space-y-4">
          {
            featuredPosts.map((project) => (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block p-4 rounded-lg bg-gray-800 bg-opacity-50 hover:bg-opacity-70 transition-all scroll-reveal group"
              >
                <div class="flex items-start gap-3">
                  <img
                    src={project.image.url}
                    alt={project.image.alt}
                    class="w-10 h-10 rounded-lg object-cover flex-shrink-0"
                  />
                  <div class="flex-1">
                    <h4 class="font-bold mb-1 group-hover:text-[#ffe895] transition-colors">
                      {project.title}
                    </h4>
                    <p class="text-xs text-gray-400 mb-2">{project.publisher}</p>
                    <p class="text-sm opacity-90">{project.description}</p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>

        <div class="mt-6 scroll-reveal">
          <h3 class="font-semibold mb-2">Tech Stack</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >React.js</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >React Native</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >Next.js</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >Vue.js</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >TypeScript</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >Go & Gin</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >GraphQL</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >WebSocket</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >Playwright</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >TailwindCSS</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">MUI</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >PostgreSQL</span
            >
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm"
              >Docker</span
            >
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 group social-bar">
        {
          aboutPageContent.work.items.map((item, index) => (
            <div class={`scroll-reveal hover-lift delay-${index * 100}`}>
              <ResumeItem {...item} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="mt-32 max-w-2xl mx-auto px-6 sm:flex sm:gap-16 animate-fadeInRight delay-800"
  >
    <h2 class="mb-8 sm:mb-0 opacity-60 navbar">Connect</h2>
    <div>
      <div class="mb-6 scroll-reveal">
        <p class="mb-4">
          I'm always excited to collaborate on interesting projects and open to
          new opportunities. Whether you want to:
        </p>
        <ul class="list-disc ml-6 mb-4 space-y-2">
          <li>Discuss a potential project</li>
          <li>Explore remote work opportunities</li>
          <li>Share tech insights and experiences</li>
          <li>Just say hello! 👋</li>
        </ul>
        <p>Feel free to reach out through any of these platforms:</p>
      </div>
      <div class="grid grid-cols-2 gap-2 group social-bar">
        {
          aboutPageContent.connect.links.map((item, index) => (
            <div class={`scroll-reveal hover-lift delay-${index * 150}`}>
              <SocialLinkBox {...item} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    // Scroll reveal animation
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
        }
      });
    }, observerOptions);

    document.querySelectorAll(".scroll-reveal").forEach((el) => {
      observer.observe(el);
    });

    // Add hover animation to images
    const images = document.querySelectorAll(
      "#about-image-left, #about-image-right",
    );
    images.forEach((img) => {
      img.addEventListener("mouseenter", () => {
        (img as HTMLElement).style.transform =
          (img as HTMLElement).id === "about-image-left"
            ? "scale(1.05) rotate(-8deg)"
            : "scale(1.05) rotate(8deg)";
      });
      img.addEventListener("mouseleave", () => {
        (img as HTMLElement).style.transform =
          (img as HTMLElement).id === "about-image-left"
            ? "scale(1) rotate(-6deg)"
            : "scale(1) rotate(6deg)";
      });
    });
  </script>
</Layout>
