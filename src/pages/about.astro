---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { aboutPageContent } from "../config";
import ResumeItem from "../components/ResumeItem.astro";
import SocialLinkBox from "../components/SocialLinkBox.astro";
---

<Layout seo={aboutPageContent.seo}>
  <!-- Floating particles background -->
  <div class="floating-particles">
    <div
      class="particle"
      style="top: 15%; left: 15%; width: 5px; height: 5px; animation-delay: 0s;"
    >
    </div>
    <div
      class="particle"
      style="top: 25%; right: 25%; width: 3px; height: 3px; animation-delay: 3s;"
    >
    </div>
    <div
      class="particle"
      style="top: 60%; left: 8%; width: 4px; height: 4px; animation-delay: 5s;"
    >
    </div>
    <div
      class="particle"
      style="bottom: 20%; right: 15%; width: 6px; height: 6px; animation-delay: 7s;"
    >
    </div>
    <div
      class="particle"
      style="bottom: 40%; left: 25%; width: 3px; height: 3px; animation-delay: 2s;"
    >
    </div>
  </div>

  <section class="mt-10 max-w-2xl mx-auto px-6">
    <div class="animate-fadeInDown">
      <h1 class="text-3xl mb-1">About</h1>
      <p class="opacity-60 mb-10 subtitle">{aboutPageContent.subtitle}</p>
    </div>

    <div class="mb-14 animate-fadeInUp delay-200">
      <p class="mb-5 sm:text-left scroll-reveal">
        Hello 👋, I'm <span class="font-bold">Hai Trinh (Ethan Nguyen)</span>, a passionate Software Engineer based in Ho Chi Minh City 🇻🇳. With over 3 years of experience, I specialize in crafting exceptional digital experiences through <span class="gradient-link">full-stack development</span>, with a particular focus on frontend excellence.
      </p>

      <p class="mb-5 sm:text-left scroll-reveal">
        I've had the privilege of building solutions across diverse sectors - from high-frequency trading platforms and sophisticated banking systems to modern beauty tech and IoT platforms. My expertise lies in architecting scalable frontend systems using <span class="gradient-link">React.js, Next.js, and TypeScript</span>.
      </p>

      <div class="mb-5 sm:text-left scroll-reveal">
        <h3 class="text-xl font-semibold mb-2">🎯 Key Highlights:</h3>
        <ul class="list-disc ml-6 space-y-2">
          <li>Led frontend architecture for multiple enterprise-scale applications</li>
          <li>Reduced application load time by 40% through performance optimization</li>
          <li>Mentored 15+ junior developers and conducted technical training sessions</li>
          <li>Implemented CI/CD pipelines reducing deployment time by 60%</li>
        </ul>
      </div>

      <p class="mb-5 sm:text-left scroll-reveal">
        My technical toolkit includes modern technologies like <strong>Redux Toolkit</strong>, <strong>TanStack Query</strong>, <strong>Vite</strong>, <strong>Rsbuild</strong>, <strong>Rspack</strong>, <strong>CI/CD Pipeline</strong>, and <strong>Docker</strong>. I'm passionate about clean code architecture, pixel-perfect UI implementation, and creating delightful user experiences.
      </p>

      <p class="mb-5 sm:text-left scroll-reveal">
        Beyond coding, I'm an avid learner 🧠, coffee enthusiast ☕, and fitness advocate 💪. I believe in continuous improvement and staying updated with the latest tech trends while maintaining a healthy work-life balance.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row animate-fadeInLeft delay-400">
      <Image
        id="about-image-left"
        src={aboutPageContent.about.image_l.url}
        alt={aboutPageContent.about.image_l.alt}
        width={350}
        height={250}
        loading="lazy"
        decoding="async"
        quality={100}
        densities={[1.5, 2]}
        class="w-[350px] h-[250px] object-cover rounded-xl sm:-rotate-6 sm:block image-effect profile-image hover-glow"
      />
      <Image
        id="about-image-right"
        src={aboutPageContent.about.image_r.url}
        alt={aboutPageContent.about.image_r.alt}
        width={150}
        height={250}
        loading="lazy"
        decoding="async"
        quality={100}
        densities={[1.5, 2]}
        class="hidden w-[150px] h-[250px] object-cover rounded-xl rotate-6 mx-auto sm:ml-auto sm:block image-effect profile-image hover-glow delay-200"
      />
    </div>
  </section>

      <section
    class="my-20 mt-32 max-w-2xl mx-auto px-6 sm:flex sm:gap-16 animate-fadeInUp delay-600"
  >
    <h2 class="mb-8 sm:mb-0 opacity-60 navbar">Experience</h2>
    <div>
      <div class="mb-8 scroll-reveal">
        <h3 class="text-xl font-semibold mb-4">Featured Projects</h3>
        <div class="space-y-4">
          <div class="p-4 rounded-lg bg-gray-800 bg-opacity-50 hover:bg-opacity-70 transition-all scroll-reveal">
            <h4 class="font-bold mb-2">🌐 Real-time Trading Platform (Bolt Technologies)</h4>
            <p class="text-sm opacity-90 mb-2">Developed a high-performance trading platform for commodities with real-time price updates and order execution.</p>
            <ul class="list-disc ml-4 text-sm opacity-80">
              <li>Integrated with Vietnam Commodity Exchange (MXV)</li>
              <li>Implemented real-time order book and price charts</li>
              <li>Built robust error handling and failover systems</li>
            </ul>
          </div>

          <div class="p-4 rounded-lg bg-gray-800 bg-opacity-50 hover:bg-opacity-70 transition-all scroll-reveal">
            <h4 class="font-bold mb-2">💅 KOMO Beauty Platform (EDS)</h4>
            <p class="text-sm opacity-90 mb-2">Led the development of a comprehensive beauty service platform ecosystem:</p>
            <ul class="list-disc ml-4 text-sm opacity-80">
              <li>Customer booking platform with real-time availability</li>
              <li>Admin dashboard for multi-branch salon management</li>
              <li>Staff management and scheduling system</li>
            </ul>
          </div>
        </div>

        <div class="mt-6 scroll-reveal">
          <h3 class="font-semibold mb-2">Tech Stack</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">React.js</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">Next.js</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">TypeScript</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">Redux Toolkit</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">Socket.io</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">GraphQL</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">Flutter</span>
            <span class="px-2 py-1 bg-gray-700 rounded-full text-sm">Docker</span>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 group social-bar">
        {
          aboutPageContent.work.items.map((item, index) => (
            <div class={`scroll-reveal hover-lift delay-${index * 100}`}>
              <ResumeItem {...item} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="mt-32 max-w-2xl mx-auto px-6 sm:flex sm:gap-16 animate-fadeInRight delay-800"
  >
    <h2 class="mb-8 sm:mb-0 opacity-60 navbar">Connect</h2>
    <div>
      <div class="mb-6 scroll-reveal">
        <p class="mb-4">I'm always excited to collaborate on interesting projects and open to new opportunities. Whether you want to:</p>
        <ul class="list-disc ml-6 mb-4 space-y-2">
          <li>Discuss a potential project</li>
          <li>Explore remote work opportunities</li>
          <li>Share tech insights and experiences</li>
          <li>Just say hello! 👋</li>
        </ul>
        <p>Feel free to reach out through any of these platforms:</p>
      </div>
      <div class="grid grid-cols-2 gap-2 group social-bar">
        {
          aboutPageContent.connect.links.map((item, index) => (
            <div class={`scroll-reveal hover-lift delay-${index * 150}`}>
              <SocialLinkBox {...item} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    // Scroll reveal animation
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
        }
      });
    }, observerOptions);

    document.querySelectorAll(".scroll-reveal").forEach((el) => {
      observer.observe(el);
    });

    // Add hover animation to images
    const images = document.querySelectorAll(
      "#about-image-left, #about-image-right",
    );
    images.forEach((img) => {
      img.addEventListener("mouseenter", () => {
        (img as HTMLElement).style.transform =
          (img as HTMLElement).id === "about-image-left"
            ? "scale(1.05) rotate(-8deg)"
            : "scale(1.05) rotate(8deg)";
      });
      img.addEventListener("mouseleave", () => {
        (img as HTMLElement).style.transform =
          (img as HTMLElement).id === "about-image-left"
            ? "scale(1) rotate(-6deg)"
            : "scale(1) rotate(6deg)";
      });
    });
  </script>
</Layout>
