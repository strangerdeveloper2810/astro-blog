---
type Props = { 
  gtmId?: string;
  measurementId: string;
};
const props = Astro.props as Props;
const { gtmId, measurementId } = props;
---

{gtmId ? (
  <!-- Google Tag Manager -->
  <script type="text/partytown" is:inline>
    // Initialize dataLayer first
    window.dataLayer = window.dataLayer || [];
    
    // GTM initialization
    (function(w,d,s,l,i){
      w[l]=w[l]||[];
      w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
         })(window,document,'script','dataLayer','${gtmId}');
  </script>
) : (
  <!-- Fallback to Direct GA4 -->
  <script
    type="text/partytown"
    is:inline
    src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
  
  <script type="text/partytown" is:inline>
    // Initialize gtag function globally
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    window.gtag = gtag;

    // Wait for script to load
    window.addEventListener('load', function() {
      if (typeof gtag === 'function') {
        gtag("js", new Date());

                 gtag("config", '${measurementId}', {
          enhanced_measurement: {
            scrolls: true,
            outbound_clicks: true,
            site_search: true,
            video_engagement: true,
            file_downloads: true,
          },
          cookie_flags: "SameSite=None;Secure",
          send_page_view: true,
          anonymize_ip: true,
          custom_map: {
            custom_parameter_1: "page_category",
            custom_parameter_2: "content_group",
          },
        });

        // Track page category
        const pathname = window.location.pathname;
        let pageCategory = "home";

        if (pathname.includes("/about")) {
          pageCategory = "about";
        } else if (pathname === "/") {
          pageCategory = "home";
        }

        gtag("event", "page_view_enhanced", {
          page_category: pageCategory,
          page_location: window.location.href,
          page_title: document.title,
        });
      }
    });
  </script>
)}

<!-- GTM NoScript Fallback -->
{gtmId && (
  <noscript>
    <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>
)} 