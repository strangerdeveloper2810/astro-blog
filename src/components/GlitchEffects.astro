---
// CodingEffects.astro - Coding and engineering themed background
---

<!-- Coding Background Canvas -->
<canvas id="coding-canvas" class="coding-canvas"></canvas>

<!-- Code Terminal Overlay -->
<div id="terminal-overlay" class="terminal-overlay"></div>

<!-- Circuit Board Scanner -->
<div id="circuit-scanner" class="circuit-scanner"></div>

<script>
  class CodingEffects {
    private canvas: HTMLCanvasElement | null;
    private ctx: CanvasRenderingContext2D | null;
    private codeSnippets: string[];
    private techSymbols: string[];
    private binaryStreams: string[];
    private animationId: number | null;

    constructor() {
      this.canvas = document.getElementById(
        "coding-canvas",
      ) as HTMLCanvasElement;
      this.ctx = this.canvas ? this.canvas.getContext("2d") : null;

      this.codeSnippets = [
        "function createPortfolio() {",
        "  const skills = ['React', 'Vue', 'TypeScript'];",
        "  return buildAmazingApp(skills);",
        "}",
        "const engineer = {",
        "  name: 'Nguyen Hai Trinh',",
        "  role: 'Software Engineer',",
        "  experience: '3+ years'",
        "};",
        "import { useState, useEffect } from 'react';",
        "const [projects, setProjects] = useState([]);",
        "useEffect(() => {",
        "  fetchProjects().then(setProjects);",
        "}, []);",
        "class SoftwareEngineer {",
        "  constructor(name, skills) {",
        "    this.name = name;",
        "    this.skills = skills;",
        "  }",
        "  build() {",
        "    return 'Amazing software';",
        "  }",
        "}",
        "const tradingPlatform = {",
        "  charts: 'TradingView',",
        "  realtime: 'WebSocket',",
        "  framework: 'React 19'",
        "};",
        "// API Integration",
        "const apiClient = axios.create({",
        "  baseURL: 'https://api.example.com',",
        "  timeout: 5000",
        "});",
        "// GraphQL Query",
        "const GET_PROJECTS = gql`",
        "  query GetProjects {",
        "    projects {",
        "      id",
        "      name",
        "      description",
        "    }",
        "  }",
        "`;",
        "// WebSocket Connection",
        "const ws = new WebSocket('ws://localhost:8080');",
        "ws.onmessage = (event) => {",
        "  const data = JSON.parse(event.data);",
        "  updateChart(data);",
        "};",
        "// Docker Configuration",
        "FROM node:18-alpine",
        "WORKDIR /app",
        "COPY package*.json ./",
        "RUN npm install",
        "COPY . .",
        "EXPOSE 3000",
        "CMD ['npm', 'start']",
        "// Database Schema",
        "CREATE TABLE users (",
        "  id INT PRIMARY KEY,",
        "  name VARCHAR(100),",
        "  email VARCHAR(100)",
        ");",
        "// Testing",
        "describe('Portfolio Component', () => {",
        "  it('renders correctly', () => {",
        "    render(<Portfolio />);",
        "    expect(screen.getByText('Software Engineer')).toBeInTheDocument();",
        "  });",
        "});",
        "// Performance Optimization",
        "const memoizedComponent = React.memo(({ data }) => {",
        "  return <div>{data.name}</div>;",
        "});",
        "// Error Handling",
        "try {",
        "  const result = await riskyOperation();",
        "} catch (error) {",
        "  console.error('Operation failed:', error);",
        "}",
      ];

      this.techSymbols = [
        "</>",
        "{ }",
        "()",
        "[]",
        "=>",
        "++",
        "--",
        "&&",
        "||",
        "==",
        "!=",
        "<=",
        ">=",
        "/*",
        "*/",
        "//",
        ".js",
        ".ts",
        ".jsx",
        ".tsx",
        ".vue",
        ".html",
        ".css",
        ".scss",
        ".json",
        ".md",
        ".yml",
        ".xml",
        "npm",
        "yarn",
        "pnpm",
        "git",
        "docker",
        "kubernetes",
        "aws",
        "gcp",
        "azure",
        "react",
        "vue",
        "angular",
        "svelte",
        "next",
        "nuxt",
        "sveltekit",
        "typescript",
        "javascript",
        "python",
        "java",
        "go",
        "rust",
        "c++",
        "c#",
        "mysql",
        "postgresql",
        "mongodb",
        "redis",
        "elasticsearch",
        "graphql",
        "rest",
        "websocket",
        "grpc",
        "tcp",
        "udp",
        "jest",
        "cypress",
        "playwright",
        "vitest",
        "mocha",
        "chai",
        "webpack",
        "vite",
        "rollup",
        "esbuild",
        "parcel",
        "babel",
        "tailwind",
        "bootstrap",
        "mui",
        "antd",
        "chakra",
        "styled-components",
        "linux",
        "windows",
        "macos",
        "ubuntu",
        "centos",
        "debian",
        "nginx",
        "apache",
        "express",
        "fastify",
        "koa",
        "hapi",
        "microservices",
        "monolith",
        "serverless",
        "edge",
        "cdn",
        "api",
      ];

      this.binaryStreams = [
        "1010 1100 1111 0001",
        "A5F3 C7E9 2B8D 4F1A",
        "0101 1010 1111 0000",
        "F7A2 9C4E 1B8D 3F5A",
        "1100 0011 1010 0101",
        "E9C7 2A5F 8D3B 1F4A",
        "1111 0000 1010 0101",
        "B3F7 8A2C 5E9D 1F4A",
        "0000 1111 0101 1010",
        "C8E2 7F5A 9B3D 1F4A",
        "1010 0101 1111 0000",
        "D4F2 8C7A 3E9B 1F5A",
        "0101 1111 0000 1010",
        "E7A3 9F5C 2B8D 1F4A",
        "1111 1010 0101 0000",
        "F2A8 7C5E 9B3D 1F4A",
        "0000 0101 1111 1010",
        "A5F3 8C7E 2B9D 1F4A",
        "1010 1111 0000 0101",
        "B7E2 9F5C 3A8D 1F4A",
        "0101 0000 1111 1010",
        "C8F3 7A5E 9B2D 1F4A",
        "1111 0101 0000 1010",
        "D2A7 8F5C 3E9B 1F4A",
      ];

      this.animationId = null;
      this.init();
    }

    init() {
      this.setupCodingCanvas();
      this.setupTerminalOverlay();
      this.setupCircuitScanner();
      this.startAnimation();
    }

    setupCodingCanvas() {
      if (!this.canvas || !this.ctx) return;

      const resizeCanvas = () => {
        if (!this.canvas) return;
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
      };

      resizeCanvas();
      window.addEventListener("resize", resizeCanvas);

      // Set canvas style
      this.ctx.font = "12px Courier New";
      this.ctx.fillStyle = "rgba(0, 255, 0, 0.3)";
    }

    setupTerminalOverlay() {
      const terminal = document.getElementById("terminal-overlay");
      if (!terminal) return;

      // Create terminal-like elements
      const terminalLines = [
        "🚀 $ pnpm dev",
        "⚡ > Starting development server...",
        "✅ ✓ Server running on localhost:4321",
        '📝 $ git commit -m "feat: add coding background"',
        "✅ ✓ Committed successfully",
        "🧪 $ npm run test",
        "⚡ > Running test suite...",
        "✅ ✓ All tests passed",
        "🔨 $ pnpm build",
        "⚡ > Building for production...",
        "✅ ✓ Build completed successfully",
        "🚀 $ pnpm deploy",
        "⚡ > Deploying to production...",
        "✅ ✓ Deployed successfully",
        "🌐 ✓ Web is running at: https://www.ethansoftwaredeveloper.com/",
        "📤 $ git push origin main",
        "✅ ✓ Pushed to remote repository",
        "🐳 $ docker build -t portfolio .",
        "⚡ > Building Docker image...",
        "✅ ✓ Image built successfully",
        "🎉 Deployment complete! Portfolio is live!",
        "💻 Ready for next development cycle...",
        "🔍 $ npm run lint",
        "⚡ > Running linter...",
        "✅ ✓ No linting errors found",
        "📊 $ npm run analyze",
        "⚡ > Analyzing bundle size...",
        "✅ ✓ Bundle analysis complete",
        "🔄 $ git pull origin main",
        "✅ ✓ Latest changes pulled",
        "🛡️ $ npm audit",
        "⚡ > Running security audit...",
        "✅ ✓ No vulnerabilities found",
        "📈 $ npm run performance-test",
        "⚡ > Running performance tests...",
        "✅ ✓ Performance tests passed",
        "🎯 All systems operational!",
        "🚀 Ready for next sprint!",
      ];

      // Add some lines immediately for scroll testing
      const immediateLines = terminalLines.slice(0, 15);
      immediateLines.forEach((line, index) => {
        const lineElement = document.createElement("div");
        lineElement.className = "terminal-line";
        lineElement.textContent = line;
        lineElement.style.opacity = "1";
        terminal.appendChild(lineElement);
      });

      // Add remaining lines with animation
      const remainingLines = terminalLines.slice(15);
      remainingLines.forEach((line, index) => {
        setTimeout(() => {
          const lineElement = document.createElement("div");
          lineElement.className = "terminal-line";
          lineElement.textContent = line;
          terminal.appendChild(lineElement);

          // Auto scroll to bottom when new line is added
          terminal.scrollTop = terminal.scrollHeight;
        }, index * 2000);
      });
    }

    setupCircuitScanner() {
      const scanner = document.getElementById("circuit-scanner");
      if (!scanner) return;

      // Create circuit-like scanning effect
      for (let i = 0; i < 20; i++) {
        const circuitLine = document.createElement("div");
        circuitLine.className = "circuit-line";
        circuitLine.style.left = Math.random() * 100 + "%";
        circuitLine.style.top = Math.random() * 100 + "%";
        circuitLine.style.width = Math.random() * 200 + 100 + "px";
        circuitLine.style.transform = `rotate(${Math.random() * 360}deg)`;
        circuitLine.style.animationDelay = Math.random() * 5 + "s";
        scanner.appendChild(circuitLine);
      }
    }

    startAnimation() {
      let frameCount = 0;
      const animate = () => {
        if (!this.ctx || !this.canvas) return;

        frameCount++;

        // Clear canvas with fade effect
        this.ctx.fillStyle = "rgba(15, 15, 35, 0.05)";
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

        // Draw code snippets with wave effect
        this.drawCodeSnippets(frameCount);

        // Draw tech symbols with floating effect
        this.drawTechSymbols(frameCount);

        // Draw binary streams with falling effect
        this.drawBinaryStreams(frameCount);

        // Draw additional effects
        this.drawFloatingElements(frameCount);
        this.drawConnectingLines(frameCount);

        this.animationId = requestAnimationFrame(animate);
      };

      animate();
    }

    drawCodeSnippets(frameCount) {
      if (!this.ctx) return;

      this.ctx.font = "14px Courier New";

      for (let i = 0; i < 8; i++) {
        const snippet =
          this.codeSnippets[
            Math.floor(Math.random() * this.codeSnippets.length)
          ];
        const baseX = (i * 200) % (this.canvas!.width - 200);
        const baseY = (i * 100) % (this.canvas!.height - 50);

        // Wave effect
        const waveOffset = Math.sin((frameCount + i * 50) * 0.02) * 20;
        const x = baseX + waveOffset;
        const y = baseY + Math.sin((frameCount + i * 30) * 0.01) * 10;

        // Fade effect - brighter and more visible
        const alpha = 0.6 + Math.sin((frameCount + i * 20) * 0.03) * 0.3;
        this.ctx.fillStyle = `rgba(0, 255, 0, ${alpha})`;

        this.ctx.fillText(snippet, x, y);
      }
    }

    drawTechSymbols(frameCount) {
      if (!this.ctx) return;

      this.ctx.font = "18px Courier New";

      for (let i = 0; i < 12; i++) {
        const symbol =
          this.techSymbols[Math.floor(Math.random() * this.techSymbols.length)];
        const baseX = (i * 150) % (this.canvas!.width - 50);
        const baseY = (i * 80) % (this.canvas!.height - 20);

        // Floating effect
        const floatX = baseX + Math.sin((frameCount + i * 40) * 0.015) * 30;
        const floatY = baseY + Math.cos((frameCount + i * 25) * 0.012) * 15;

        // Rotation effect
        this.ctx.save();
        this.ctx.translate(floatX, floatY);
        this.ctx.rotate((frameCount + i * 10) * 0.005);

        // Glow effect - brighter and more visible
        const alpha = 0.7 + Math.sin((frameCount + i * 15) * 0.02) * 0.3;
        this.ctx.fillStyle = `rgba(0, 255, 100, ${alpha})`;

        this.ctx.fillText(symbol, 0, 0);
        this.ctx.restore();
      }
    }

    drawBinaryStreams(frameCount) {
      if (!this.ctx) return;

      this.ctx.font = "12px Courier New";

      for (let i = 0; i < 6; i++) {
        const binary =
          this.binaryStreams[
            Math.floor(Math.random() * this.binaryStreams.length)
          ];
        const baseX = (i * 200) % (this.canvas!.width - 150);

        // Falling effect
        const fallSpeed = 0.5 + i * 0.1;
        const y =
          (frameCount * fallSpeed + i * 200) % (this.canvas!.height + 50);

        // Fade in/out effect - brighter and more visible
        const alpha = Math.sin((frameCount + i * 30) * 0.01) * 0.4 + 0.5;
        this.ctx.fillStyle = `rgba(0, 255, 150, ${alpha})`;

        this.ctx.fillText(binary, baseX, y);
      }
    }

    drawFloatingElements(frameCount) {
      if (!this.ctx) return;

      // Draw floating particles
      for (let i = 0; i < 20; i++) {
        const x = (i * 100 + frameCount * 0.5) % this.canvas!.width;
        const y =
          (i * 80 + Math.sin(frameCount * 0.01 + i) * 50) % this.canvas!.height;

        this.ctx.fillStyle = `rgba(0, 255, 0, ${0.3 + Math.sin(frameCount * 0.02 + i) * 0.2})`;
        this.ctx.fillRect(x, y, 3, 3);
      }

      // Draw connecting lines
      for (let i = 0; i < 10; i++) {
        const x1 = (i * 150 + frameCount * 0.3) % this.canvas!.width;
        const y1 =
          (i * 100 + Math.sin(frameCount * 0.008 + i) * 30) %
          this.canvas!.height;
        const x2 = ((i + 5) * 150 + frameCount * 0.3) % this.canvas!.width;
        const y2 =
          ((i + 5) * 100 + Math.sin(frameCount * 0.008 + i + 5) * 30) %
          this.canvas!.height;

        this.ctx.strokeStyle = `rgba(0, 255, 0, ${0.3 + Math.sin(frameCount * 0.01 + i) * 0.2})`;
        this.ctx.lineWidth = 2;
        this.ctx.beginPath();
        this.ctx.moveTo(x1, y1);
        this.ctx.lineTo(x2, y2);
        this.ctx.stroke();
      }
    }

    drawConnectingLines(frameCount) {
      if (!this.ctx) return;

      // Draw network-like connections
      for (let i = 0; i < 15; i++) {
        const centerX = this.canvas!.width / 2;
        const centerY = this.canvas!.height / 2;
        const radius = 100 + Math.sin(frameCount * 0.005 + i) * 50;
        const angle = (frameCount * 0.002 + i * 0.4) % (Math.PI * 2);

        const x = centerX + Math.cos(angle) * radius;
        const y = centerY + Math.sin(angle) * radius;

        this.ctx.strokeStyle = `rgba(0, 255, 100, ${0.4 + Math.sin(frameCount * 0.01 + i) * 0.3})`;
        this.ctx.lineWidth = 2;
        this.ctx.beginPath();
        this.ctx.moveTo(centerX, centerY);
        this.ctx.lineTo(x, y);
        this.ctx.stroke();

        // Draw node - brighter and larger
        this.ctx.fillStyle = `rgba(0, 255, 0, ${0.6 + Math.sin(frameCount * 0.02 + i) * 0.4})`;
        this.ctx.fillRect(x - 3, y - 3, 6, 6);
      }
    }
    destroy() {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => new CodingEffects());
  } else {
    new CodingEffects();
  }
</script>

<style>
  /* Coding Canvas */
  .coding-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -2;
    opacity: 0.6;
  }

  /* Terminal Overlay */
  .terminal-overlay {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 380px;
    height: 400px;
    background: rgba(0, 0, 0, 0.9);
    border: 2px solid rgba(0, 255, 0, 0.6);
    border-radius: 12px;
    padding: 20px;
    font-family: "Courier New", monospace;
    font-size: 13px;
    color: rgba(0, 255, 0, 1);
    z-index: -1;
    overflow-y: auto;
    overflow-x: hidden;
    backdrop-filter: blur(8px);
    box-shadow: 0 0 20px rgba(0, 255, 0, 0.3);
  }

  /* Custom scrollbar for terminal */
  .terminal-overlay::-webkit-scrollbar {
    width: 8px;
  }

  .terminal-overlay::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
  }

  .terminal-overlay::-webkit-scrollbar-thumb {
    background: rgba(0, 255, 0, 0.6);
    border-radius: 4px;
    border: 1px solid rgba(0, 255, 0, 0.3);
  }

  .terminal-overlay::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 255, 0, 0.8);
  }

  .terminal-line {
    margin: 2px 0;
    opacity: 0;
    animation: terminalFadeIn 0.5s ease-in forwards;
    white-space: nowrap;
    overflow: visible;
  }

  @keyframes terminalFadeIn {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Circuit Scanner */
  .circuit-scanner {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .circuit-line {
    position: absolute;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 255, 0, 0.3),
      transparent
    );
    animation: circuitPulse 5s ease-in-out infinite;
  }

  @keyframes circuitPulse {
    0%,
    100% {
      opacity: 0.1;
      transform: scaleX(1);
    }
    50% {
      opacity: 0.4;
      transform: scaleX(1.2);
    }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .terminal-overlay {
      width: 250px;
      height: 150px;
      font-size: 10px;
    }

    .coding-canvas {
      opacity: 0.4;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .terminal-line,
    .circuit-line {
      animation: none;
    }

    .coding-canvas {
      opacity: 0.2;
    }
  }
</style>
