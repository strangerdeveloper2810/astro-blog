---
import { Icon } from "astro-icon/components";
import type { SocialLink } from "../types/config";

type Props = SocialLink;

const { title, url, icon, external } = Astro.props;
---

<a
  href={url}
  class="p-4 rounded-xl bg-slate-900/40 border border-white/10 hover:border-cyan-500/40 flex items-center gap-3.5 transition-all duration-300 group hover:-translate-y-0.5 hover:shadow-lg hover:shadow-cyan-500/10"
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
>
  <div class="p-2 rounded-lg bg-white/5 text-cyan-400 group-hover:bg-cyan-500 group-hover:text-slate-950 transition-colors">
    <Icon name={icon} width={22} height={22} />
  </div>
  <div class="flex items-center justify-between w-full">
    <p class="font-medium text-slate-200 group-hover:text-white text-sm">{title}</p>
    <div class="rotate-45 text-slate-400 group-hover:text-cyan-400 transition-colors">
      <Icon name="mdi:arrow-up" width={18} height={18} />
    </div>
  </div>
</a>
