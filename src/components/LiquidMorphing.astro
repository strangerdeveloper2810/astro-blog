---
// LiquidMorphing.astro - Liquid morphing and blob animations
---

<!-- Animated Blob Background -->
<div class="blob-container">
  <svg viewBox="0 0 500 500" class="blob-svg">
    <defs>
      <linearGradient id="gradient1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#00abda;stop-opacity:0.1"></stop>
        <stop offset="50%" style="stop-color:#ffe895;stop-opacity:0.05"></stop>
        <stop offset="100%" style="stop-color:#ff6b9d;stop-opacity:0.1"></stop>
      </linearGradient>
      <linearGradient id="gradient2" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#ff6b9d;stop-opacity:0.1"></stop>
        <stop offset="50%" style="stop-color:#00abda;stop-opacity:0.05"></stop>
        <stop offset="100%" style="stop-color:#ffe895;stop-opacity:0.1"></stop>
      </linearGradient>
      <filter id="glow">
        <feGaussianBlur stdDeviation="3" result="coloredBlur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="coloredBlur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <path id="blob1" fill="url(#gradient1)" filter="url(#glow)"></path>
    <path id="blob2" fill="url(#gradient2)" filter="url(#glow)"></path>
  </svg>
</div>

<!-- Liquid Loading Animation -->
<div id="liquid-loader" class="liquid-loader hidden">
  <div class="liquid-container">
    <div class="liquid-wave"></div>
    <div class="liquid-text">Loading...</div>
  </div>
</div>

<!-- Morphing Button Examples -->
<div class="morphing-elements">
  <!-- These will be applied to existing elements via JavaScript -->
</div>

<script>
  class LiquidMorphing {
    private blob1: SVGPathElement | null;
    private blob2: SVGPathElement | null;
    private morphingSpeed: number;
    private time: number;
    private prefersReducedMotion: boolean;
    private transitionsEnabled: boolean;

    constructor() {
      this.blob1 = document.getElementById(
        "blob1",
      ) as unknown as SVGPathElement;
      this.blob2 = document.getElementById(
        "blob2",
      ) as unknown as SVGPathElement;
      this.morphingSpeed = 0.02;
      this.time = 0;
      this.prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      this.transitionsEnabled =
        !this.prefersReducedMotion &&
        localStorage.getItem("pageTransitions") !== "disabled";

      this.init();

      // Performance optimization - use passive listeners
      this.setupPerformanceOptimizations();
    }

    init() {
      this.setupBlobAnimation();
      this.setupLiquidButtons();
      this.setupFluidHover();
      this.setupMorphingTransitions();
      this.setupLiquidLoader();
    }

    setupBlobAnimation() {
      if (!this.blob1 || !this.blob2) return;

      const animateBlobs = () => {
        this.time += this.morphingSpeed;

        // Generate organic blob paths
        const blob1Path = this.generateBlobPath(250, 250, 80, this.time);
        const blob2Path = this.generateBlobPath(
          250,
          250,
          60,
          this.time + Math.PI,
        );

        if (this.blob1) this.blob1.setAttribute("d", blob1Path);
        if (this.blob2) this.blob2.setAttribute("d", blob2Path);

        requestAnimationFrame(animateBlobs);
      };

      animateBlobs();
    }

    generateBlobPath(
      centerX: number,
      centerY: number,
      baseRadius: number,
      time: number,
    ) {
      const points = 8;
      const angleStep = (Math.PI * 2) / points;
      let path = "";

      const coords = [];

      for (let i = 0; i <= points; i++) {
        const angle = i * angleStep;
        const radius =
          baseRadius +
          Math.sin(time + angle * 3) * 20 +
          Math.cos(time * 1.5 + angle * 2) * 15;
        const x = centerX + Math.cos(angle) * radius;
        const y = centerY + Math.sin(angle) * radius;
        coords.push({ x, y });
      }

      // Create smooth bezier curves
      path += `M ${coords[0].x} ${coords[0].y}`;

      for (let i = 0; i < coords.length - 1; i++) {
        const current = coords[i];
        const next = coords[i + 1];
        const controlPoint1 = {
          x: current.x + (next.x - current.x) * 0.3,
          y: current.y + (next.y - current.y) * 0.3,
        };
        const controlPoint2 = {
          x: next.x - (next.x - current.x) * 0.3,
          y: next.y - (next.y - current.y) * 0.3,
        };

        path += ` C ${controlPoint1.x} ${controlPoint1.y}, ${controlPoint2.x} ${controlPoint2.y}, ${next.x} ${next.y}`;
      }

      return path + " Z";
    }

    setupLiquidButtons() {
      const buttons = document.querySelectorAll("a, button, .link-item");

      buttons.forEach((button) => {
        button.classList.add("liquid-morph");

        // Create liquid overlay
        const overlay = document.createElement("div");
        overlay.className = "liquid-overlay";
        overlay.style.cssText = `
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), 
            rgba(0, 171, 218, 0.2) 0%,
            rgba(255, 232, 149, 0.1) 50%,
            transparent 100%
          );
          border-radius: inherit;
          opacity: 0;
          transition: opacity 0.3s ease;
          pointer-events: none;
          transform: scale(0);
        `;

        (button as HTMLElement).style.position = "relative";
        (button as HTMLElement).style.overflow = "hidden";
        button.appendChild(overlay);

        button.addEventListener("mouseenter", (e) => {
          overlay.style.opacity = "1";
          overlay.style.transform = "scale(1)";
          overlay.style.transition =
            "all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
        });

        button.addEventListener("mouseleave", () => {
          overlay.style.opacity = "0";
          overlay.style.transform = "scale(0)";
        });

        (button as HTMLElement).addEventListener(
          "mousemove",
          (e: MouseEvent) => {
            const rect = (button as HTMLElement).getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;

            overlay.style.setProperty("--mouse-x", `${x}%`);
            overlay.style.setProperty("--mouse-y", `${y}%`);
          },
        );
      });
    }

    setupFluidHover() {
      const cards = document.querySelectorAll(".skill-card, .profile-image");

      cards.forEach((card) => {
        card.addEventListener("mouseenter", () => {
          (card as HTMLElement).style.borderRadius = "20px 5px 20px 5px";
          (card as HTMLElement).style.transition =
            "all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
        });

        card.addEventListener("mouseleave", () => {
          (card as HTMLElement).style.borderRadius = "";
        });
      });
    }

    setupMorphingTransitions() {
      // Skip transitions if disabled or reduced motion
      if (!this.transitionsEnabled) return;

      // Morphing page transitions
      const links = document.querySelectorAll('a[href^="/"]');
      let transitionIndex = 0;

      links.forEach((link) => {
        (link as HTMLElement).addEventListener("click", (e: MouseEvent) => {
          if (e.ctrlKey || e.metaKey) return; // Don't hijack if opening in new tab

          e.preventDefault();

          // Cycle through different transition effects
          const transitions = [
            () =>
              this.showLiquidTransition(
                () => (window.location.href = (link as HTMLAnchorElement).href),
              ),
            () =>
              this.showMorphingTransition(
                () => (window.location.href = (link as HTMLAnchorElement).href),
              ),
            () =>
              this.showClothTransition(
                () => (window.location.href = (link as HTMLAnchorElement).href),
              ),
          ];

          transitions[transitionIndex % 3]();
          transitionIndex++;
        });
      });
    }

    setupPerformanceOptimizations() {
      // Reduce motion if user prefers it
      if (this.prefersReducedMotion) {
        document.body.classList.add("reduce-motion");
      }

      // Optimize blob animations for low-end devices
      const isLowEndDevice =
        navigator.hardwareConcurrency <= 2 ||
        /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
          navigator.userAgent,
        );

      if (isLowEndDevice) {
        document.body.classList.add("low-end-device");
      }
    }

    showMorphingTransition(callback: () => void) {
      if (!this.transitionsEnabled) {
        callback();
        return;
      }

      // Create morphing circles transition
      const transition = document.createElement("div");
      transition.className = "morphing-circles-transition";

      // Reduce circles for low-end devices
      const circleCount = document.body.classList.contains("low-end-device")
        ? 3
        : 5;

      // Create morphing circles
      const circles = [];
      for (let i = 0; i < circleCount; i++) {
        const circle = document.createElement("div");
        circle.className = "morphing-circle";

        const angle = (i / circleCount) * Math.PI * 2;
        const radius = 100;
        const x = Math.cos(angle) * radius + window.innerWidth / 2;
        const y = Math.sin(angle) * radius + window.innerHeight / 2;

        circle.style.cssText = `
          position: absolute;
          width: 80px;
          height: 80px;
          border-radius: 50%;
          background: linear-gradient(45deg, 
            rgba(0, 171, 218, 0.9), 
            rgba(138, 43, 226, 0.8),
            rgba(255, 0, 150, 0.7));
          left: ${x - 40}px;
          top: ${y - 40}px;
          transform: scale(0);
          filter: blur(0px);
          box-shadow: 0 0 30px rgba(0, 171, 218, 0.6);
          will-change: transform, filter, opacity;
        `;

        circles.push(circle);
        transition.appendChild(circle);
      }

      transition.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10000;
        pointer-events: none;
        background: rgba(0, 0, 0, 0);
        will-change: background;
      `;

      document.body.appendChild(transition);

      // Animate circles expanding and morphing
      circles.forEach((circle, index) => {
        setTimeout(() => {
          circle.style.transition =
            "all 1s cubic-bezier(0.68, -0.55, 0.265, 1.55)";
          circle.style.transform = "scale(20)";
          circle.style.filter = "blur(20px)";
          circle.style.opacity = "0.3";
        }, index * 100);
      });

      // Background fade
      setTimeout(() => {
        transition.style.transition = "background 0.5s ease-out";
        transition.style.background = "rgba(0, 0, 0, 0.95)";
      }, 300);

      // Execute callback
      setTimeout(() => {
        callback();
      }, 800);

      // Cleanup
      setTimeout(() => {
        if (transition.parentNode) {
          transition.style.transition = "opacity 0.3s ease-out";
          transition.style.opacity = "0";
          setTimeout(() => {
            document.body.removeChild(transition);
          }, 300);
        }
      }, 1200);
    }

    showClothTransition(callback: () => void) {
      if (!this.transitionsEnabled) {
        callback();
        return;
      }

      // Create cloth curtain transition
      const transition = document.createElement("div");
      transition.className = "cloth-curtain-transition";

      // Reduce panels for low-end devices
      const panelCount = document.body.classList.contains("low-end-device")
        ? 4
        : 8;

      // Create cloth panels
      const panels: HTMLElement[] = [];

      for (let i = 0; i < panelCount; i++) {
        const panel = document.createElement("div");
        panel.className = "cloth-panel";

        const delay = i * 0.1;
        const rotation = i % 2 === 0 ? -5 : 5;

        panel.style.cssText = `
          position: absolute;
          top: 0;
          left: ${(i / panelCount) * 100}%;
          width: ${100 / panelCount + 2}%;
          height: 100%;
          background: linear-gradient(180deg, 
            rgba(0, 171, 218, 0.9) 0%,
            rgba(138, 43, 226, 0.8) 50%,
            rgba(0, 0, 0, 0.95) 100%);
          transform: translateY(-100%) rotateX(${rotation}deg);
          transform-origin: bottom center;
          animation-delay: ${delay}s;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
          backdrop-filter: blur(10px);
          will-change: transform;
        `;

        panels.push(panel);
        transition.appendChild(panel);
      }

      transition.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10000;
        pointer-events: none;
        perspective: 1000px;
        overflow: hidden;
      `;

      document.body.appendChild(transition);

      // Animate cloth panels falling down
      panels.forEach((panel, index) => {
        setTimeout(() => {
          panel.style.transition =
            "transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
          panel.style.transform = "translateY(0) rotateX(0deg)";
        }, index * 80);
      });

      // Execute callback
      setTimeout(() => {
        callback();
      }, 800);

      // Animate panels rolling up
      setTimeout(() => {
        panels.forEach((panel, index) => {
          setTimeout(() => {
            panel.style.transition =
              "transform 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55)";
            panel.style.transform = "translateY(100%) rotateX(15deg)";
          }, index * 50);
        });
      }, 1000);

      // Cleanup
      setTimeout(() => {
        if (transition.parentNode) {
          document.body.removeChild(transition);
        }
      }, 1800);
    }

    setupLiquidLoader() {
      const loader = document.getElementById("liquid-loader");
      if (!loader) return;

      window.showLiquidLoader = () => {
        loader.classList.remove("hidden");
        loader.style.display = "flex";
      };

      window.hideLiquidLoader = () => {
        loader.style.opacity = "0";
        setTimeout(() => {
          loader.classList.add("hidden");
          loader.style.display = "none";
          loader.style.opacity = "1";
        }, 500);
      };
    }

    showLiquidTransition(callback: () => void) {
      // Skip if transitions disabled
      if (!this.transitionsEnabled) {
        callback();
        return;
      }

      // Create ripple transition overlay
      const transition = document.createElement("div");
      transition.className = "liquid-ripple-transition";

      // Reduce ripples for low-end devices
      const rippleCount = document.body.classList.contains("low-end-device")
        ? 2
        : 3;

      // Create multiple ripple circles for smooth effect
      const ripples: HTMLElement[] = [];
      for (let i = 0; i < rippleCount; i++) {
        const ripple = document.createElement("div");
        ripple.className = "ripple-circle";
        ripple.style.cssText = `
          position: absolute;
          border-radius: 50%;
          background: radial-gradient(circle, 
            rgba(0, 171, 218, 0.8) 0%, 
            rgba(0, 171, 218, 0.6) 50%, 
            rgba(0, 171, 218, 0.3) 100%);
          transform: scale(0);
          filter: blur(${i * 2}px);
          animation-delay: ${i * 0.1}s;
          will-change: transform, opacity;
        `;
        ripples.push(ripple);
        transition.appendChild(ripple);
      }

      transition.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10000;
        pointer-events: none;
        overflow: hidden;
        background: linear-gradient(135deg, 
          rgba(0, 0, 0, 0) 0%, 
          rgba(0, 171, 218, 0.1) 50%, 
          rgba(0, 0, 0, 0.8) 100%);
        will-change: background;
      `;

      document.body.appendChild(transition);

      // Get click position or center of screen
      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;

      // Calculate maximum distance to cover entire screen
      const maxDistance = Math.sqrt(
        Math.pow(window.innerWidth, 2) + Math.pow(window.innerHeight, 2),
      );

      // Position and animate ripples with RAF for smoother animation
      const animateRipples = () => {
        ripples.forEach((ripple, index) => {
          const size = maxDistance * 2;
          ripple.style.width = `${size}px`;
          ripple.style.height = `${size}px`;
          ripple.style.left = `${centerX - size / 2}px`;
          ripple.style.top = `${centerY - size / 2}px`;

          // Smooth scaling animation
          ripple.style.animation = `liquidRipple 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards`;
          ripple.style.animationDelay = `${index * 0.15}s`;
        });
      };

      requestAnimationFrame(animateRipples);

      // Add background fade
      transition.style.animation =
        "fadeToLiquid 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards";

      // Execute callback and cleanup
      setTimeout(() => {
        callback();
      }, 800);

      setTimeout(() => {
        if (transition.parentNode) {
          transition.style.animation = "fadeFromLiquid 0.4s ease-out forwards";
          setTimeout(() => {
            document.body.removeChild(transition);
          }, 400);
        }
      }, 1200);
    }

    generateTransitionPath(progress: number) {
      // This method is no longer used with the new ripple effect
      // Keeping for backward compatibility
      return `M 0,100 L 100,100 L 100,0 L 0,0 Z`;
    }
  }

  // Initialize liquid morphing
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => new LiquidMorphing());
  } else {
    new LiquidMorphing();
  }

  // Global declarations
  declare global {
    interface Window {
      showLiquidLoader: () => void;
      hideLiquidLoader: () => void;
    }
  }
</script>

<style>
  /* Blob Container */
  .blob-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .blob-svg {
    width: 150%;
    height: 150%;
    position: absolute;
    top: -25%;
    left: -25%;
  }

  /* Liquid Morphing Elements */
  .liquid-morph {
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  .liquid-morph:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 10px 20px rgba(0, 171, 218, 0.3));
  }

  /* Liquid Loader */
  .liquid-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    backdrop-filter: blur(10px);
  }

  .liquid-loader.hidden {
    display: none;
  }

  .liquid-container {
    position: relative;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(45deg, #00abda, #ffe895);
    animation: liquid-spin 2s linear infinite;
  }

  .liquid-wave {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.3) 0%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 100%
    );
    animation: liquid-wave 1.5s ease-in-out infinite;
    transform-origin: center bottom;
  }

  .liquid-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #ffffff;
    font-weight: bold;
    font-size: 16px;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    z-index: 1;
  }

  @keyframes liquid-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes liquid-wave {
    0%,
    100% {
      transform: scaleY(1) rotate(0deg);
      top: 50%;
    }
    50% {
      transform: scaleY(0.8) rotate(180deg);
      top: 40%;
    }
  }

  /* Morphing Shapes */
  .morphing-shape {
    width: 60px;
    height: 60px;
    background: linear-gradient(45deg, #00abda, #ffe895);
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    animation: morph-shape 8s ease-in-out infinite;
    opacity: 0.3;
    position: absolute;
  }

  @keyframes morph-shape {
    0%,
    100% {
      border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
      transform: rotate(0deg) scale(1);
    }
    25% {
      border-radius: 70% 30% 30% 70% / 70% 70% 30% 30%;
      transform: rotate(90deg) scale(1.1);
    }
    50% {
      border-radius: 50% 50% 50% 50% / 50% 50% 50% 50%;
      transform: rotate(180deg) scale(0.9);
    }
    75% {
      border-radius: 30% 70% 30% 70% / 70% 30% 70% 30%;
      transform: rotate(270deg) scale(1.05);
    }
  }

  /* Fluid Text Effects */
  .fluid-text {
    background: linear-gradient(90deg, #00abda, #ffe895, #ff6b9d, #00abda);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: fluid-text-flow 3s ease-in-out infinite;
  }

  @keyframes fluid-text-flow {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Liquid Button Hover */
  .liquid-overlay {
    mix-blend-mode: overlay;
  }

  /* Advanced Morphing Cards */
  .morph-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      rgba(0, 171, 218, 0.1) 0%,
      rgba(255, 232, 149, 0.05) 50%,
      rgba(255, 107, 157, 0.1) 100%
    );
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .morph-card::before {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: conic-gradient(
      from 0deg,
      transparent,
      rgba(0, 171, 218, 0.3),
      transparent
    );
    animation: morph-card-spin 4s linear infinite;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .morph-card:hover::before {
    opacity: 1;
  }

  @keyframes morph-card-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Performance Optimizations */
  .reduce-motion * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .low-end-device .blob-svg {
    animation-duration: 8s !important;
  }

  .low-end-device .ripple-circle {
    filter: none !important;
  }

  .low-end-device .morphing-circle {
    box-shadow: none !important;
    filter: none !important;
  }

  .low-end-device .cloth-panel {
    backdrop-filter: none !important;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3) !important;
  }

  /* Smooth Animation Base */
  * {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    -moz-backface-visibility: hidden;
    -ms-backface-visibility: hidden;
  }

  /* Liquid Ripple Transition */
  .liquid-ripple-transition {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10000;
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 171, 218, 0.1) 50%,
      rgba(0, 0, 0, 0.8) 100%
    );
    transform: translateZ(0);
  }

  .ripple-circle {
