---
import { Icon } from "astro-icon/components";
interface Props {
  text: string;
  href: string;
  icon: string;
  external?: boolean;
  noAnchor?: boolean;
}

const { text, href, external, noAnchor, icon } = Astro.props;
---

{
  !noAnchor ? (
    <a
      href={href}
      target={external ? "_blank" : "_self"}
      class="flex items-center gap-2 opacity-60 group-hover:opacity-30 hover:!opacity-100 transition-all duration-300 link-item hover-lift"
    >
      <Icon
        name={icon}
        width={24}
        height={24}
        class="transition-all duration-300 hover:scale-110 hover:rotate-6"
      />
      <span class="transition-all duration-300 hover:text-[#ffe895] font-medium">
        {text}
      </span>
    </a>
  ) : (
    <div class="flex items-center gap-2 opacity-60 group-hover:opacity-30 hover:!opacity-100 transition-all duration-300 link-item">
      <Icon
        name={icon}
        width={24}
        height={24}
        class="transition-all duration-300 hover:scale-110"
      />
      <span class="transition-all duration-300 hover:text-[#ffe895] font-medium">
        {text}
      </span>
    </div>
  )
}

<style>
  .link-item:hover {
    transform: translateX(3px) translateY(-2px);
  }

  .link-item:hover Icon {
    filter: drop-shadow(0 0 8px rgba(0, 171, 218, 0.4));
  }

  .link-item:active {
    transform: translateX(1px) translateY(0px);
  }
</style>
