---
import { Icon } from "astro-icon/components";
import type { Skill } from "../types/config";

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
---

<div
  class="group relative cyber-card rounded-2xl p-5 transition-all duration-300 hover:shadow-xl hover:shadow-cyan-500/10 hover:-translate-y-1 h-44 flex flex-col justify-between overflow-hidden border border-white/10 bg-slate-900/60 backdrop-blur-md skill-card-item"
  data-skill-name={skill.name.toLowerCase()}
  data-skill-desc={skill.description?.toLowerCase() || ""}
>
  <!-- Icon & Name -->
  <div class="flex items-center gap-3.5 mb-2">
    <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 group-hover:bg-cyan-500/10 group-hover:border-cyan-500/30 transition-colors flex items-center justify-center min-w-12 h-12">
      {
        skill.icon.startsWith("/") ? (
          <img
            src={skill.icon}
            alt={skill.name}
            width={32}
            height={32}
            class="w-8 h-8 object-contain transition-transform duration-300 group-hover:scale-110"
          />
        ) : (
          <Icon
            name={skill.icon}
            width={32}
            height={32}
            class="transition-transform duration-300 group-hover:scale-110"
          />
        )
      }
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="font-bold text-sm sm:text-base text-white group-hover:text-cyan-400 transition-colors truncate">
        {skill.name}
      </h3>
    </div>
  </div>

  <!-- Description -->
  <div class="flex-1">
    {
      skill.description && (
        <p class="text-xs text-slate-300 leading-relaxed line-clamp-3">
          {skill.description}
        </p>
      )
    }
  </div>

  <!-- Hover accent overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-cyan-500/5 to-indigo-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
  >
  </div>
</div>
