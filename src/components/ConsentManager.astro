---
// Consent Manager for GDPR Compliance
---

<!-- Google Consent Mode v2 -->
<script type="text/partytown">
  // Default consent state
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  // Set default consent to 'denied' as a placeholder
  gtag("consent", "default", {
    analytics_storage: "denied",
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    functionality_storage: "granted",
    security_storage: "granted",
    wait_for_update: 500,
  });

  // Auto-grant consent for analytics (since this is a portfolio site)
  // In production, you might want to show a consent banner instead
  gtag("consent", "update", {
    analytics_storage: "granted",
  });
</script>

<!-- Simple Consent Banner (Optional) -->
<div
  id="consent-banner"
  class="fixed bottom-0 left-0 right-0 bg-gray-900 text-white p-4 z-50 hidden"
>
  <div
    class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <div class="text-sm">
      <p>
        This website uses cookies to improve your experience and analyze website
        traffic.
        <a href="/privacy" class="underline text-blue-300">Learn more</a>
      </p>
    </div>
    <div class="flex gap-2">
      <button
        id="accept-cookies"
        class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded text-sm font-medium"
      >
        Accept
      </button>
      <button
        id="reject-cookies"
        class="bg-gray-600 hover:bg-gray-700 px-4 py-2 rounded text-sm font-medium"
      >
        Reject
      </button>
    </div>
  </div>
</div>

<script>
  // Simple consent management
  const consentBanner = document.getElementById("consent-banner");
  const acceptBtn = document.getElementById("accept-cookies");
  const rejectBtn = document.getElementById("reject-cookies");

  // Check if consent was already given
  const hasConsent = localStorage.getItem("analytics-consent");

  if (!hasConsent) {
    // Show banner after 2 seconds
    setTimeout(() => {
      consentBanner?.classList.remove("hidden");
    }, 2000);
  }

  acceptBtn?.addEventListener("click", () => {
    localStorage.setItem("analytics-consent", "granted");
    consentBanner?.classList.add("hidden");

    // Update consent
    if (typeof gtag !== "undefined") {
      gtag("consent", "update", {
        analytics_storage: "granted",
      });
    }
  });

  rejectBtn?.addEventListener("click", () => {
    localStorage.setItem("analytics-consent", "denied");
    consentBanner?.classList.add("hidden");

    // Keep consent denied
    if (typeof gtag !== "undefined") {
      gtag("consent", "update", {
        analytics_storage: "denied",
      });
    }
  });
</script>
