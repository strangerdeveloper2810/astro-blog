---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { navBarLinks, identity, googleAnalytics } from "../config";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import GoogleTagManager from "../components/GoogleTagManager.astro";
import ScrollAnimations from "../components/ScrollAnimations.astro";
import type { SEOInfo } from "../types/config";
import "@styles/base.css";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;
const ogImageUrl = seo.image;
const canonicalUrl = seo.canonical || seo.url;
import GlitchEffects from "../components/GlitchEffects.astro";
---

<script>
  const linkMenuButton = document.getElementById(
    "link-menu-button",
  ) as HTMLButtonElement;
  const linkMenu = document.getElementById("link-menu") as HTMLDivElement;
  const openIndicator = document.getElementById(
    "open-indicator",
  ) as HTMLSpanElement;

  linkMenuButton.addEventListener("click", () => {
    if (linkMenu.classList.contains("opacity-0")) {
      linkMenu.classList.remove("pointer-events-none");
      linkMenu.classList.remove("opacity-0");
      openIndicator.innerText = "-";
    } else {
      linkMenu.classList.add("pointer-events-none");
      linkMenu.classList.add("opacity-0");
      openIndicator.innerText = "+";
    }
  });

  document.addEventListener("click", (event) => {
    const isLinkMenuButtonClicked =
      event.target === linkMenuButton ||
      linkMenuButton.contains(event.target as Node);
    const isLinkMenuClicked =
      event.target === linkMenu || linkMenu.contains(event.target as Node);

    if (!isLinkMenuButtonClicked && !isLinkMenuClicked) {
      linkMenu.classList.add("pointer-events-none");
      linkMenu.classList.add("opacity-0");
      openIndicator.innerText = "+";
    }
  });
</script>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz@9..40&family=Kanit&display=swap"
      as="style"
    />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=KoHo:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      as="style"
    />

    <!-- Favicon and App Icons -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon/favicon-96x96.png"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Font Connections -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz@9..40&family=Kanit&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=KoHo:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- External Scripts -->
    <script async defer src="https://buttons.github.io/buttons.js" is:inline
    ></script>

    <!-- SEO Meta Tags -->
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.keywords && <meta name="keywords" content={seo.keywords} />}
    {seo.author && <meta name="author" content={seo.author} />}
    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="msapplication-TileColor" content="#ffffff" />

    <!-- Open Graph / Facebook Meta Tags -->
    <meta property="og:url" content={seo.url} />
    <meta property="og:type" content={seo.type || "website"} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={seo.title} />
    <meta
      property="og:site_name"
      content="Hai Trinh (Ethan Nguyen) Portfolio"
    />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={seo.domain} />
    <meta property="twitter:url" content={seo.url} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={seo.title} />
    <meta name="twitter:creator" content="@ethantrinh" />

    <!-- Structured Data -->
    {
      seo.structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(seo.structuredData)}
        />
      )
    }

    <!-- Auto-consent enabled in analytics components -->

    <!-- Google Analytics / Tag Manager -->
    {
      googleAnalytics.enabled &&
        (googleAnalytics.gtmId ? (
          <GoogleTagManager
            gtmId={googleAnalytics.gtmId}
            measurementId={googleAnalytics.measurementId}
          />
        ) : (
          <GoogleAnalytics measurementId={googleAnalytics.measurementId} />
        ))
    }
  </head>
  <body class="min-h-screen bg-[#040612] text-[#f1f5f9] antialiased selection:bg-fuchsia-500 selection:text-white">
    <header class="sticky top-0 z-50 backdrop-blur-2xl bg-[#040612]/80 border-b border-fuchsia-500/20 shadow-xl shadow-fuchsia-950/30 transition-all duration-300">
      <div
        class="px-4 sm:px-6 py-3.5 max-w-6xl mx-auto flex items-center justify-between"
      >
        <a href="/" class="flex items-center gap-3 group">
          <div class="relative p-0.5 rounded-full bg-gradient-to-r from-amber-400 via-fuchsia-500 to-cyan-400 group-hover:scale-105 transition-transform duration-300 shadow-md shadow-fuchsia-500/30">
            <Image
              src={identity.logo}
              alt={identity.name}
              width={42}
              height={42}
              loading="eager"
              decoding="async"
              quality={100}
              densities={[1.5, 2]}
              class="w-[40px] h-[40px] rounded-full object-cover border-2 border-[#040612]"
            />
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-white tracking-tight group-hover:text-amber-400 transition-colors hidden sm:inline-block font-mono-code text-sm">
              {identity.name}
            </span>
            <span class="text-[9px] font-mono-code text-fuchsia-400/90 tracking-widest hidden sm:inline-block font-bold">
              MILANO SHIP // AWESOME TECH MIX VOL. 1
            </span>
          </div>
        </a>

        <nav class="ml-auto mr-4 sm:mr-0 navbar flex items-center gap-3">
          <div class="hidden lg:flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-400/30 text-[10px] font-mono-code text-amber-300">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            COSMIC ORBIT: STABLE 100%
          </div>

          <ul class="hidden sm:flex sm:items-center sm:gap-1 bg-slate-900/80 p-1.5 rounded-xl border border-fuchsia-500/25 backdrop-blur-md">
            {
              navBarLinks.map((link) => {
                const isActive =
                  Astro.url.pathname === link.url ||
                  (link.url !== "/" && Astro.url.pathname.startsWith(link.url));
                return (
                  <li>
                    <a
                      class={`px-4 py-1.5 rounded-lg font-mono-code font-bold text-xs tracking-wider transition-all duration-200 block ${
                        isActive
                          ? "bg-gradient-to-r from-amber-500 via-fuchsia-600 to-cyan-500 text-white shadow-md shadow-fuchsia-500/30 font-extrabold"
                          : "text-slate-400 hover:text-slate-100 hover:bg-white/5"
                      }`}
                      href={link.url}
                      target={link.external ? "_blank" : "_self"}
                    >
                      {link.title}
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <!-- Mobile menu with background highlight -->
          <div class="relative sm:hidden">
            <button
              id="link-menu-button"
              class="flex items-center gap-1.5 font-medium text-slate-300 hover:text-cyan-400 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10"
              aria-label="Toggle Navigation Menu"
            >
              Menu <span id="open-indicator" class="text-cyan-400 font-bold">+</span>
            </button>
            <div
              id="link-menu"
              class="absolute right-0 mt-2 p-2 bg-slate-900/95 backdrop-blur-xl border border-white/10 rounded-xl w-48 transition-all ease-in-out duration-300 opacity-0 pointer-events-none shadow-2xl z-50"
            >
              <ul class="space-y-1">
                {
                  navBarLinks.map((link) => {
                    const isActive =
                      Astro.url.pathname === link.url ||
                      (link.url !== "/" &&
                        Astro.url.pathname.startsWith(link.url));
                    return (
                      <li>
                        <a
                          class={`block px-4 py-2 rounded-lg text-sm font-medium transition-all ${
                            isActive
                              ? "bg-gradient-to-r from-cyan-500 to-indigo-600 text-white font-semibold"
                              : "text-slate-300 hover:text-white hover:bg-white/5"
                          }`}
                          href={link.url}
                          target={link.external ? "_blank" : "_self"}
                        >
                          {link.title}
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </nav>
        <div class="flex items-center gap-2">
          <a
            href={`mailto:${identity.email}`}
            class="p-2 text-slate-400 hover:text-cyan-400 hover:bg-white/5 rounded-full transition-all duration-200"
            aria-label="Email Nguyen Hai Trinh"
            title="Send Email"
          >
            <Icon name="mdi:email" width={20} height={20} />
          </a>
        </div>
      </div>
    </header>
    <main class="mb-24 min-h-[calc(100vh-200px)]">
      <slot />
    </main>
    <footer class="border-t border-white/10 py-8 text-center text-xs text-slate-500">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} {identity.name}. Built with Astro & Tailwind CSS.</p>
        <div class="flex items-center gap-4">
          <a href="https://github.com/strangerdeveloper2810" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">GitHub</a>
          <a href="https://linkedin.com/in/trinhhainguyen" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">LinkedIn</a>
          <a href={`mailto:${identity.email}`} class="hover:text-slate-300 transition-colors">Contact</a>
        </div>
      </div>
    </footer>

    <!-- Scroll Animations -->
    <ScrollAnimations />
    <GlitchEffects />
  </body>
</html>
